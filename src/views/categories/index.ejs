<%- include('../partials/head', { pageTitle: 'Vehicle Categories', activeMenu: 'categories' }) %>

<div class="corona-wrapper">
  <%- include('../partials/sidebar', { activeMenu: 'categories' }) %>

  <div class="corona-main">
    <%- include('../partials/navbar') %>

    <main class="corona-content">
      <%- include('../partials/flash-messages') %>

      <!-- Page Header -->
      <div class="page-header">
        <div>
          <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Categories' } ] }) %>
          <h1 class="page-title">Vehicle Categories</h1>
          <p class="page-subtitle">Organize vehicle classifications (Bikes, Cars, Heavy Vehicles, etc.)</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="loadCategories()">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
          </button>
          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="bi bi-plus-lg me-1"></i> Add Category
          </button>
          <a href="/categories/create" class="btn btn-outline-primary btn-sm d-none d-md-inline-block">
            <i class="bi bi-box-arrow-up-right me-1"></i> Full Form
          </a>
        </div>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="card mb-3">
        <div class="card-body p-3">
          <div class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" id="categorySearchInput" placeholder="Search categories by title or type...">
              </div>
            </div>
            <div class="col text-end">
              <span class="text-muted small">Total: <strong id="categoriesCountSpan" class="text-dark">—</strong> categories</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Categories Table Card -->
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 searchable-table">
            <thead>
              <tr>
                <th style="width: 70px;">ID</th>
                <th>Category</th>
                <th>Classification</th>
                <th>Created</th>
                <th class="text-end" style="width: 140px;">Actions</th>
              </tr>
            </thead>
            <tbody id="categoriesTableBody">
              <!-- Populated by categories.js -->
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<!-- Create Category Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="createCategoryModalLabel"><i class="bi bi-grid-plus text-primary me-2"></i>Add Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="createCategoryForm" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Category Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Bike, Car, Truck" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Vehicle Type Classification <span class="text-danger">*</span></label>
            <select name="type" class="form-select" required>
              <option value="" disabled selected>Select vehicle classification</option>
              <option value="two-wheeler">Two-Wheeler (Bike / Scooter)</option>
              <option value="four-wheeler">Four-Wheeler (Hatchback / Sedan / SUV)</option>
              <option value="heavy-vehicle">Commercial / Heavy Vehicle</option>
              <option value="electric">Electric Vehicle (EV)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Category Icon / Photo</label>
            <input type="file" name="photo" class="form-control" accept="image/*">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
            Save Category
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editCategoryModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editCategoryForm" enctype="multipart/form-data">
        <input type="hidden" name="cid" value="">
        <div class="modal-body">
          <div class="d-flex align-items-center gap-3 mb-3">
            <img src="/public/images/placeholder.svg" id="editCategoryPhotoPreview" class="table-thumb" style="width: 56px; height: 56px;">
            <div>
              <div class="fw-semibold">Change Image</div>
              <input type="file" name="photo" class="form-control form-control-sm mt-1" accept="image/*">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Category Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Vehicle Type Classification <span class="text-danger">*</span></label>
            <select name="type" class="form-select" required>
              <option value="two-wheeler">Two-Wheeler (Bike / Scooter)</option>
              <option value="four-wheeler">Four-Wheeler (Hatchback / Sedan / SUV)</option>
              <option value="heavy-vehicle">Commercial / Heavy Vehicle</option>
              <option value="electric">Electric Vehicle (EV)</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/public/js/categories.js"></script>
