<%- include('../partials/head', { pageTitle: 'Service Bookings', activeMenu: 'bookings' }) %>

<div class="wrapper">
  <%- include('../partials/navbar') %>
  <%- include('../partials/sidebar', { activeMenu: 'bookings' }) %>

  <div class="content-wrapper">
    <!-- Content Header -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2 align-items-center">
          <div class="col-sm-6">
            <h1 class="m-0 font-weight-bold text-dark">
              <i class="fas fa-calendar-check text-primary mr-2"></i>Service Bookings
            </h1>
            <p class="text-muted small mb-0">Track, reschedule, and manage customer vehicle maintenance reservations</p>
          </div>
          <div class="col-sm-6 text-sm-right mt-2 mt-sm-0">
            <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Bookings' } ] }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <section class="content">
      <div class="container-fluid">
        <%- include('../partials/flash-messages') %>

        <!-- Actions & Filter Toolbar Card -->
        <div class="card card-outline card-primary elevation-1 mb-3">
          <div class="card-body p-3">
            <div class="row align-items-center">
              <div class="col-md-5 col-lg-4 mb-2 mb-md-0">
                <div class="input-group">
                  <div class="input-group-prepend">
                    <span class="input-group-text bg-light border-right-0"><i class="fas fa-search text-muted"></i></span>
                  </div>
                  <input type="text" class="form-control border-left-0" id="bookingSearchInput" placeholder="Search by customer, vehicle, reg no...">
                </div>
              </div>
              <div class="col-md-4 col-lg-3 mb-2 mb-md-0">
                <select class="form-control custom-select" id="bookingTypeFilter">
                  <option value="">All Vehicle Types</option>
                  <option value="Car">Car (4-Wheeler)</option>
                  <option value="Bike">Bike / Two-Wheeler</option>
                  <option value="Heavy">Commercial / Heavy</option>
                </select>
              </div>
              <div class="col-md-3 col-lg-5 text-md-right">
                <button type="button" class="btn btn-default btn-sm mr-1" onclick="loadBookings()">
                  <i class="fas fa-sync-alt mr-1"></i> Refresh
                </button>
                <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#createBookingModal">
                  <i class="fas fa-plus mr-1"></i> Book Appointment
                </button>
                <a href="/bookings/create" class="btn btn-outline-primary btn-sm ml-1 d-none d-lg-inline-block">
                  <i class="fas fa-external-link-alt mr-1"></i> Full Form
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Bookings Table Card -->
        <div class="card card-outline card-secondary elevation-1">
          <div class="card-header border-0 d-flex align-items-center justify-content-between">
            <h3 class="card-title font-weight-bold text-dark">
              <i class="fas fa-list mr-1"></i> Appointments List
            </h3>
            <div class="card-tools">
              <span class="badge badge-light border px-2 py-1">Total: <strong id="bookingsCountSpan" class="text-primary">—</strong> records</span>
            </div>
          </div>
          <div class="card-body table-responsive p-0">
            <table class="table table-hover table-striped table-valign-middle mb-0 searchable-table">
              <thead>
                <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                  <th style="width: 70px;">ID</th>
                  <th>Vehicle Details</th>
                  <th>Customer</th>
                  <th>Service Name</th>
                  <th>Type</th>
                  <th>Scheduled Slot</th>
                  <th class="text-right" style="width: 130px;">Actions</th>
                </tr>
              </thead>
              <tbody id="bookingsTableBody">
                <!-- Dynamically populated by bookings.js -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  </div>

  <%- include('../partials/footer') %>

<!-- Create Appointment Modal -->
<div class="modal fade" id="createBookingModal" tabindex="-1" role="dialog" aria-labelledby="createBookingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title font-weight-bold" id="createBookingModalLabel">
          <i class="fas fa-calendar-plus mr-2"></i>Book Service Appointment
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="createBookingForm" enctype="multipart/form-data">
        <div class="modal-body p-4">
          <div class="row">
            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Customer Account <span class="text-danger">*</span></label>
              <select name="id" id="bookingUidSelect" class="form-control custom-select" required>
                <option value="" disabled selected>Loading customer accounts...</option>
              </select>
            </div>
            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Requested Service <span class="text-danger">*</span></label>
              <select name="service_name" id="bookingServiceSelect" class="form-control custom-select" required>
                <option value="" disabled selected>Loading catalog services...</option>
              </select>
            </div>

            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Vehicle Make & Model <span class="text-danger">*</span></label>
              <input type="text" name="vehicle_name" class="form-control" placeholder="e.g. Hyundai Creta, Honda City" required>
            </div>
            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Registration Number <span class="text-danger">*</span></label>
              <input type="text" name="registration_no" class="form-control" placeholder="e.g. MH 12 AB 1234" required>
            </div>

            <div class="col-md-4 form-group">
              <label class="font-weight-semibold">Vehicle Type <span class="text-danger">*</span></label>
              <select name="vehicle_type" class="form-control custom-select" required>
                <option value="Car" selected>Car (4-Wheeler)</option>
                <option value="Bike">Bike (2-Wheeler)</option>
                <option value="Truck">Commercial Vehicle</option>
                <option value="EV">Electric Vehicle (EV)</option>
              </select>
            </div>
            <div class="col-md-4 form-group">
              <label class="font-weight-semibold">Slot Date <span class="text-danger">*</span></label>
              <input type="date" name="slot_date" class="form-control" required>
            </div>
            <div class="col-md-4 form-group">
              <label class="font-weight-semibold">Slot Time <span class="text-danger">*</span></label>
              <input type="time" name="slot_time" class="form-control" required>
            </div>

            <div class="col-12 form-group mb-0">
              <label class="font-weight-semibold">Vehicle Photo</label>
              <div class="custom-file">
                <input type="file" name="vehicle_photo" class="custom-file-input" id="vehiclePhotoInput" accept="image/*">
                <label class="custom-file-label" for="vehiclePhotoInput">Choose vehicle image...</label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary font-weight-bold">
            <span class="spinner-border spinner-border-sm mr-1 d-none" role="status"></span>
            Confirm Appointment
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Appointment Modal -->
<div class="modal fade" id="editBookingModal" tabindex="-1" role="dialog" aria-labelledby="editBookingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title font-weight-bold" id="editBookingModalLabel">
          <i class="fas fa-edit mr-2"></i>Reschedule / Edit Appointment
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="editBookingForm" enctype="multipart/form-data">
        <input type="hidden" name="book_id" value="">
        <div class="modal-body p-4">
          <div class="d-flex align-items-center mb-3 p-3 bg-light rounded elevation-1">
            <img src="/public/images/placeholder.svg" id="editBookingPhotoPreview" class="table-thumb rounded mr-3" style="width: 56px; height: 56px; object-fit: cover;">
            <div class="flex-grow-1">
              <label class="font-weight-semibold mb-1 d-block">Update Vehicle Image</label>
              <input type="file" name="vehicle_photo" class="form-control-file" accept="image/*">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Vehicle Name <span class="text-danger">*</span></label>
              <input type="text" name="vehicle_name" class="form-control" required>
            </div>
            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Registration No <span class="text-danger">*</span></label>
              <input type="text" name="registration_no" class="form-control" required>
            </div>
            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Service Name <span class="text-danger">*</span></label>
              <input type="text" name="service_name" class="form-control" required>
            </div>
            <div class="col-md-6 form-group">
              <label class="font-weight-semibold">Vehicle Type <span class="text-danger">*</span></label>
              <select name="vehicle_type" class="form-control custom-select" required>
                <option value="Car">Car</option>
                <option value="Bike">Bike</option>
                <option value="Truck">Truck</option>
                <option value="EV">EV</option>
              </select>
            </div>
            <div class="col-md-6 form-group mb-0">
              <label class="font-weight-semibold">Slot Date <span class="text-danger">*</span></label>
              <input type="text" name="slot_date" class="form-control" placeholder="DD/MM/YYYY" required>
            </div>
            <div class="col-md-6 form-group mb-0">
              <label class="font-weight-semibold">Slot Time <span class="text-danger">*</span></label>
              <input type="text" name="slot_time" class="form-control" placeholder="e.g. 10:30 AM" required>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary font-weight-bold">
            <span class="spinner-border spinner-border-sm mr-1 d-none" role="status"></span>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/public/js/bookings.js"></script>
