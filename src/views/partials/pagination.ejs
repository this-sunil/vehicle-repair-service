<!-- Pagination bar — driven by VS.pagination() in admin.js -->
<div id="vs-pag" class="mt-4 flex flex-col items-center justify-between gap-3 sm:flex-row">
  <p class="text-xs font-medium text-slate-400" data-pag-info>Loading…</p>
  <div class="flex items-center gap-1.5">
    <button class="btn-secondary btn-sm" data-pag-prev disabled>
      <i class="bi bi-chevron-left"></i> Prev
    </button>
    <span class="rounded-xl bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-300" data-pag-label>1 / 1</span>
    <button class="btn-secondary btn-sm" data-pag-next>Next <i class="bi bi-chevron-right"></i></button>
  </div>
</div>
