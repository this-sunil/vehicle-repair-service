<%- include('../partials/head', { pageTitle: 'Appointment Details', bodyAttrs: 'data-protected data-page="bookings-show" data-id="' + (typeof bookingId !== 'undefined' ? bookingId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'bookings' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-4 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-2 flex items-center gap-3">
      <a href="/bookings" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Appointment details</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400" id="bk-subtitle">Loading…</p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <!-- Vehicle photo -->
      <div class="card overflow-hidden">
        <div class="grid h-56 place-items-center bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900" id="bk-photo-wrap">
          <i class="bi bi-image text-5xl text-slate-300 dark:text-slate-600"></i>
        </div>
        <div class="p-5">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-extrabold text-slate-900 dark:text-white" id="bk-vehicle">—</h3>
            <span class="badge-blue" id="bk-type">—</span>
          </div>
          <p class="mt-1 font-mono text-sm font-semibold tracking-wider text-slate-400" id="bk-reg">—</p>
        </div>
      </div>

      <!-- Details -->
      <div class="card p-6 lg:col-span-2">
        <h3 class="mb-5 flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-info-circle text-brand-500"></i> Appointment Information</h3>
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Customer</dt>
            <dd class="mt-1.5 flex items-center gap-2.5 font-semibold text-slate-800 dark:text-slate-100" id="bk-customer">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Phone</dt>
            <dd class="mt-1.5 font-mono text-sm font-semibold text-slate-800 dark:text-slate-100" id="bk-phone">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Service</dt>
            <dd class="mt-1.5 font-semibold text-slate-800 dark:text-slate-100" id="bk-service">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Scheduled Slot</dt>
            <dd class="mt-1.5 font-semibold text-slate-800 dark:text-slate-100" id="bk-slot">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50 sm:col-span-2">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Booked</dt>
            <dd class="mt-1.5 font-semibold text-slate-800 dark:text-slate-100" id="bk-created">—</dd>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
          <button class="btn-secondary btn-md" id="bk-del"><i class="bi bi-trash3"></i> Delete</button>
          <a href="/bookings/<%= typeof bookingId !== 'undefined' ? bookingId : '' %>/invoice" target="_blank" class="btn-secondary btn-md"><i class="bi bi-receipt"></i> Invoice</a>
          <a href="#" class="btn-primary btn-md" id="bk-edit-link"><i class="bi bi-pencil"></i> Reschedule</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/bookings.js" defer></script>
</body>
</html>
