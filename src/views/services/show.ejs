<%- include('../partials/head', { pageTitle: 'Service Details', activeMenu: 'services' }) %>

<div class="admin-wrapper">
  <%- include('../partials/sidebar', { activeMenu: 'services' }) %>

  <div class="admin-main">
    <%- include('../partials/navbar') %>

    <main class="admin-content">
      <%- include('../partials/flash-messages') %>

      <!-- Page Header -->
      <div class="page-header">
        <div>
          <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Services', url: '/services' }, { label: 'Service Details' } ] }) %>
          <h1 class="page-title">Service Details</h1>
          <p class="page-subtitle">Inspect service specifications, description, and status</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a href="/services" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Services
          </a>
          <a href="/services/<%= typeof serviceId !== 'undefined' ? serviceId : '' %>/edit" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Service
          </a>
        </div>
      </div>

      <div id="showServiceLoading" class="text-center py-5">
        <div class="spinner-border text-primary me-2"></div> Loading service details...
      </div>

      <div id="showServiceContent" class="d-none">
        <div class="row g-4">
          <div class="col-lg-8">
            <div class="card mb-4">
              <div class="card-body p-4">
                <div class="d-flex flex-column flex-sm-row gap-4 mb-4">
                  <img src="/public/images/placeholder.svg" id="showServicePhoto" alt="Service Photo" class="rounded-3 shadow-sm" style="width: 140px; height: 140px; object-fit: cover;">
                  <div class="flex-grow-1">
                    <span class="badge bg-primary-subtle text-primary mb-2">Active Catalog Service</span>
                    <h2 class="fw-bold mb-2 text-dark" id="showServiceTitle">—</h2>
                    <p class="text-muted small mb-0">Record ID: <strong id="showServiceId">#<%= typeof serviceId !== 'undefined' ? serviceId : '' %></strong> &bull; Created: <span id="showServiceCreated">—</span></p>
                  </div>
                </div>

                <h5 class="fw-bold mb-2">Service Description & Scope</h5>
                <div class="p-3 bg-light rounded text-secondary" id="showServiceDescription" style="white-space: pre-line; line-height: 1.7;">
                  —
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<script src="/public/js/services.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const serviceId = Number('<%= typeof serviceId !== 'undefined' ? serviceId : '' %>');
    if (!serviceId) return;

    try {
      const res = await apiRequest('/api/getAllService', {
        method: 'POST',
        body: { page: 1, limit: 100 }
      });

      if (res.ok && res.data.result) {
        const item = res.data.result.find(s => s.id === serviceId);
        if (item) {
          document.getElementById('showServiceTitle').textContent = item.title || 'Untitled';
          document.getElementById('showServiceDescription').textContent = item.description || 'No description provided.';
          document.getElementById('showServiceId').textContent = `#${item.id}`;
          document.getElementById('showServiceCreated').textContent = formatDate(item.created_at);
          if (item.photo) {
            document.getElementById('showServicePhoto').src = getMediaUrl(item.photo);
          }
          document.getElementById('showServiceLoading').classList.add('d-none');
          document.getElementById('showServiceContent').classList.remove('d-none');
        } else {
          document.getElementById('showServiceLoading').innerHTML = '<div class="text-danger">Service not found.</div>';
        }
      }
    } catch (e) {
      document.getElementById('showServiceLoading').innerHTML = '<div class="text-danger">Failed to load service details.</div>';
    }
  });
</script>
