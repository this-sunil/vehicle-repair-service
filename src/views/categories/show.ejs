<%- include('../partials/head', { pageTitle: 'Category Details', bodyAttrs: 'data-protected data-page="categories-show" data-id="' + (typeof categoryId !== 'undefined' ? categoryId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'categories' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/categories" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Category details</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Vehicle classification overview</p>
      </div>
    </div>

    <div class="mx-auto max-w-2xl card overflow-hidden">
      <div class="grid h-52 place-items-center bg-gradient-to-br from-brand-500 to-violet-600" id="c-photo">
        <i class="bi bi-grid-3x3-gap text-6xl text-white/70"></i>
      </div>
      <div class="p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-extrabold text-slate-900 dark:text-white" id="c-title">Loading…</h3>
          <span class="badge-blue" id="c-type">—</span>
        </div>
        <p class="mt-2 text-xs text-slate-400" id="c-added">—</p>
        <div class="mt-6 flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
          <button class="btn-secondary btn-md" id="c-del"><i class="bi bi-trash3"></i> Delete</button>
          <a href="#" class="btn-primary btn-md" id="c-edit-link"><i class="bi bi-pencil"></i> Edit Category</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/categories.js" defer></script>
</body>
</html>
