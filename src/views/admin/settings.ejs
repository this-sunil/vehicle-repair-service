<%- include('../partials/head', { pageTitle: 'Application Settings', bodyAttrs: 'data-protected data-page="settings"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'settings' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl space-y-4">

      <form id="settings-form" class="card space-y-5 p-6 sm:p-8" novalidate>
        <h3 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-sliders text-brand-500"></i> Platform Links</h3>
        <p class="-mt-3 text-xs text-slate-400">These URLs power the customer-facing app footer and policy pages.</p>

        <div>
          <label class="label" for="contact_url">Contact / Support URL</label>
          <div class="relative">
            <i class="bi bi-headset absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
            <input id="contact_url" type="url" class="input !pl-10" placeholder="https://help.vehicleservice.app" />
          </div>
          <p class="field-error hidden" data-error-for="contact_url"></p>
        </div>

        <div>
          <label class="label" for="privacy_policy_url">Privacy Policy URL</label>
          <div class="relative">
            <i class="bi bi-shield-check absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
            <input id="privacy_policy_url" type="url" class="input !pl-10" placeholder="https://vehicleservice.app/privacy" />
          </div>
          <p class="field-error hidden" data-error-for="privacy_policy_url"></p>
        </div>

        <div>
          <label class="label" for="terms_condition_url">Terms &amp; Conditions URL</label>
          <div class="relative">
            <i class="bi bi-file-earmark-text absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
            <input id="terms_condition_url" type="url" class="input !pl-10" placeholder="https://vehicleservice.app/terms" />
          </div>
          <p class="field-error hidden" data-error-for="terms_condition_url"></p>
        </div>

        <div>
          <label class="label" for="photo">Brand Logo <span class="font-normal normal-case text-slate-400">(optional)</span></label>
          <div class="flex items-center gap-4">
            <div id="settings-photo-preview" class="grid h-16 w-16 place-items-center rounded-2xl bg-slate-100 text-slate-400 dark:bg-slate-800"><i class="bi bi-image text-2xl"></i></div>
            <input id="photo" type="file" accept="image/*" class="input !py-2.5 !text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-brand-600 hover:file:bg-brand-100" />
          </div>
        </div>

        <div class="flex justify-end border-t border-slate-200 pt-5 dark:border-slate-800">
          <button type="submit" class="btn-primary btn-md"><i class="bi bi-check-lg"></i> Save Settings</button>
        </div>
      </form>

      <div class="card p-6">
        <h3 class="mb-1 flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-stars text-violet-500"></i> AI Copilot Engine</h3>
        <p class="text-xs leading-relaxed text-slate-400">Your AI copilot and insights panel run on built-in smart analytics over live data. To upgrade to Google Gemini, add a <code class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-bold text-brand-600 dark:bg-slate-800 dark:text-brand-300">GEMINI_API_KEY</code> to <code class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-bold text-brand-600 dark:bg-slate-800 dark:text-brand-300">.env</code> and restart the server.</p>
        <span class="badge-slate mt-3" id="engine-status">checking…</span>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/settings.js" defer></script>
</body>
</html>
