<%- include('../partials/head', { pageTitle: 'Vehicle Services', bodyAttrs: 'data-protected data-page="services"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'services' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-5 px-4 py-6 sm:px-6 lg:px-8">
    <%- include('../partials/flash-messages') %>

    <div class="card">
      <div class="flex flex-col gap-3 border-b border-slate-200 p-4 dark:border-slate-800 sm:flex-row sm:items-center">
        <div class="relative flex-1 sm:max-w-xs">
          <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input type="text" id="svc-search" placeholder="Search services…" class="input !pl-10" />
        </div>
        <div class="flex gap-2 sm:ml-auto">
          <button id="svc-refresh" class="btn-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
          <button id="svc-export" class="btn-secondary btn-sm"><i class="bi bi-filetype-csv"></i> Export</button>
          <a href="/services/create" class="btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Service</a>
        </div>
      </div>
    </div>

    <div id="svc-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <div class="card h-64 p-5"><div class="skeleton h-full w-full rounded-2xl"></div></div>
      <div class="card h-64 p-5"><div class="skeleton h-full w-full rounded-2xl"></div></div>
      <div class="card h-64 p-5"><div class="skeleton h-full w-full rounded-2xl"></div></div>
    </div>

    <%- include('../partials/pagination') %>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/services.js" defer></script>
</body>
</html>
