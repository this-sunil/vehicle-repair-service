<%- include('../partials/head', { pageTitle: 'Service Bookings', bodyAttrs: 'data-protected data-page="bookings"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'bookings' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-5 px-4 py-6 sm:px-6 lg:px-8">
    <%- include('../partials/flash-messages') %>

    <div class="card">
      <div class="flex flex-col gap-3 border-b border-slate-200 p-4 dark:border-slate-800 sm:flex-row sm:items-center">
        <div class="relative flex-1 sm:max-w-xs">
          <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input type="text" id="bk-search" placeholder="Search vehicle, customer, service…" class="input !pl-10" />
        </div>
        <select id="bk-type" class="input sm:max-w-44">
          <option value="">All vehicle types</option>
        </select>
        <div class="flex gap-2 sm:ml-auto">
          <button id="bk-refresh" class="btn-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
          <button id="bk-export" class="btn-secondary btn-sm"><i class="bi bi-filetype-csv"></i> Export</button>
          <a href="/bookings/create" class="btn-primary btn-sm"><i class="bi bi-calendar-plus"></i> New Booking</a>
        </div>
      </div>

      <!-- Bulk action bar -->
      <div id="bk-bulkbar" class="hidden items-center gap-3 border-b border-brand-200 bg-brand-50 px-4 py-2.5 dark:border-brand-500/30 dark:bg-brand-500/10">
        <span class="text-sm font-bold text-brand-700 dark:text-brand-300"><span id="bk-bulk-count">0</span> selected</span>
        <div class="ml-auto flex gap-2">
          <button id="bk-bulk-cancel" class="btn-secondary btn-sm">Cancel</button>
          <button id="bk-bulk-delete" class="btn-sm bg-rose-600 font-bold text-white hover:bg-rose-700"><i class="bi bi-trash3"></i> Delete Selected</button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr><th class="w-10"><input type="checkbox" id="bk-select-all" class="vs-check" aria-label="Select all" /></th><th>Customer</th><th>Vehicle</th><th>Service</th><th>Slot</th><th class="text-right">Actions</th></tr>
          </thead>
          <tbody id="bk-tbody">
            <tr><td colspan="6" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
            <tr><td colspan="6" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
            <tr><td colspan="6" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
          </tbody>
        </table>
      </div>

      <div class="p-4"><%- include('../partials/pagination') %></div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/bookings.js" defer></script>
</body>
</html>
