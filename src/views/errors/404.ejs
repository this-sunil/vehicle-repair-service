<%- include('../partials/head', { pageTitle: '404 Page Not Found' }) %>

<div class="auth-page-wrapper">
  <div class="auth-card text-center" style="max-width: 480px;">
    <div class="stat-icon warning mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2.25rem;">
      <i class="bi bi-question-circle"></i>
    </div>
    <h1 class="display-4 fw-bold text-dark mb-2">404</h1>
    <h4 class="fw-semibold text-warning mb-2">Page Not Found</h4>
    <p class="text-muted mb-4">The page or resource you requested could not be located on the server. Please verify the URL or return to dashboard.</p>
    <div class="d-flex justify-content-center gap-2">
      <a href="/dashboard" class="btn btn-primary px-4"><i class="bi bi-house-door me-1"></i> Return Home</a>
      <button onclick="window.history.back()" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-1"></i> Go Back</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
