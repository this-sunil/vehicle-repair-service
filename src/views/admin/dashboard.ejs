<%- include('../partials/head', { pageTitle: 'Executive Dashboard', bodyAttrs: 'data-protected data-page="dashboard"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'dashboard' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-6 px-4 py-6 sm:px-6 lg:px-8">

    <!-- Greeting header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">Good day, <span class="admin-user-name">Admin</span> 👋</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Here's what's happening across your service network right now.</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="badge-slate hidden sm:inline-flex"><span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400"></span><span id="dash-updated">Live</span></span>
        <button id="dash-refresh" class="btn-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        <button id="dash-ask-ai" class="btn-primary btn-sm"><i class="bi bi-stars"></i> Ask AI</button>
      </div>
    </div>

    <!-- KPI cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <% ['bookings','customers','services','shops'].forEach(function(k){ %>
        <div class="card card-hover group kpi-card animate-fadeUp p-5" data-kpi="<%= k %>">
          <div class="flex items-start justify-between">
            <div>
              <p class="kpi-label text-[11px] font-bold uppercase tracking-wider text-slate-400"></p>
              <p class="kpi-value mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                <span class="skeleton inline-block h-8 w-16 align-middle"></span>
              </p>
              <p class="kpi-delta mt-1.5 text-xs font-semibold text-slate-400"></p>
            </div>
            <div class="kpi-icon grid h-11 w-11 place-items-center rounded-2xl text-xl text-white shadow-lg"></div>
          </div>
          <a href="#" class="kpi-link mt-4 flex items-center justify-between rounded-xl bg-slate-50 px-3.5 py-2.5 text-xs font-bold text-slate-500 transition group-hover:bg-brand-50 group-hover:text-brand-600 dark:bg-slate-800/60 dark:text-slate-300">
            <span class="kpi-link-text">Manage</span><i class="bi bi-arrow-right transition-transform group-hover:translate-x-0.5"></i>
          </a>
        </div>
      <% }); %>
    </div>

    <!-- AI Insights -->
    <div class="card overflow-hidden">
      <div class="flex items-center gap-3 border-b border-slate-200 bg-gradient-to-r from-brand-600 to-violet-600 px-5 py-4 dark:border-slate-800">
        <div class="grid h-10 w-10 place-items-center rounded-xl bg-white/15">
          <i class="bi bi-stars text-xl text-white"></i>
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-bold text-white">AI Insights — auto-generated from your live data</h3>
          <p class="text-xs text-white/60" id="insights-meta">Analyzing operations…</p>
        </div>
        <span class="badge bg-white/15 text-white" id="insights-engine">AI</span>
      </div>
      <div id="insights-list" class="grid gap-3 p-5 sm:grid-cols-2 xl:grid-cols-3">
        <div class="h-24 rounded-2xl skeleton"></div>
        <div class="h-24 rounded-2xl skeleton"></div>
        <div class="h-24 rounded-2xl skeleton"></div>
      </div>
    </div>

    <!-- Charts -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <div class="card lg:col-span-2">
        <div class="flex items-center justify-between px-5 pt-5">
          <div class="flex items-center gap-2.5">
            <i class="bi bi-graph-up-arrow text-lg text-brand-500"></i>
            <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">Booking Velocity — last 7 days</h3>
          </div>
          <span class="badge-green" id="trend-badge">—</span>
        </div>
        <div class="p-4 pt-3"><div class="relative h-64"><canvas id="chart-trend"></canvas></div></div>
      </div>

      <div class="card">
        <div class="flex items-center gap-2.5 px-5 pt-5">
          <i class="bi bi-pie-chart text-lg text-amber-500"></i>
          <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">Bookings by Vehicle Type</h3>
        </div>
        <div class="p-4 pt-3"><div class="relative h-64"><canvas id="chart-types"></canvas></div></div>
      </div>

      <div class="card lg:col-span-3">
        <div class="flex items-center gap-2.5 px-5 pt-5">
          <i class="bi bi-geo-alt text-lg text-emerald-500"></i>
          <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">Service Centers by City</h3>
        </div>
        <div class="p-4 pt-3"><div class="relative h-56"><canvas id="chart-cities"></canvas></div></div>
      </div>
    </div>

    <!-- Recent activity -->
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-5">
      <div class="card xl:col-span-3">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <div class="flex items-center gap-2.5">
            <i class="bi bi-calendar-check text-lg text-brand-500"></i>
            <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">Recent Appointments</h3>
          </div>
          <a href="/bookings" class="text-xs font-bold text-brand-600 hover:text-brand-700 dark:text-brand-400">View all <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="overflow-x-auto">
          <table class="table-base">
            <thead>
              <tr><th>Customer</th><th>Vehicle</th><th>Service</th><th>Slot</th><th></th></tr>
            </thead>
            <tbody id="recent-bookings">
              <tr><td class="!px-4 !py-6" colspan="5"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
              <tr><td class="!px-4 !py-6" colspan="5"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
              <tr><td class="!px-4 !py-6" colspan="5"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card xl:col-span-2">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <div class="flex items-center gap-2.5">
            <i class="bi bi-person-plus text-lg text-emerald-500"></i>
            <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">Newest Customers</h3>
          </div>
          <a href="/users" class="text-xs font-bold text-brand-600 hover:text-brand-700 dark:text-brand-400">View all <i class="bi bi-arrow-right"></i></a>
        </div>
        <div id="recent-users" class="divide-y divide-slate-100 dark:divide-slate-800">
          <div class="flex items-center gap-3 px-5 py-4"><span class="skeleton inline-block h-9 w-9 rounded-xl"></span><div class="flex-1 space-y-2"><span class="skeleton block h-4 w-32"></span><span class="skeleton block h-3 w-20"></span></div></div>
          <div class="flex items-center gap-3 px-5 py-4"><span class="skeleton inline-block h-9 w-9 rounded-xl"></span><div class="flex-1 space-y-2"><span class="skeleton block h-4 w-32"></span><span class="skeleton block h-3 w-20"></span></div></div>
          <div class="flex items-center gap-3 px-5 py-4"><span class="skeleton inline-block h-9 w-9 rounded-xl"></span><div class="flex-1 space-y-2"><span class="skeleton block h-4 w-32"></span><span class="skeleton block h-3 w-20"></span></div></div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" defer></script>
<script src="/public/js/dashboard.js" defer></script>
</body>
</html>
