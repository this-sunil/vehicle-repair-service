<%- include('../partials/head', { pageTitle: 'Vehicle Categories', bodyAttrs: 'data-protected data-page="categories"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'categories' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-5 px-4 py-6 sm:px-6 lg:px-8">
    <%- include('../partials/flash-messages') %>

    <div class="card">
      <div class="flex flex-col gap-3 border-b border-slate-200 p-4 dark:border-slate-800 sm:flex-row sm:items-center">
        <div class="relative flex-1 sm:max-w-xs">
          <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input type="text" id="cat-search" placeholder="Search categories…" class="input !pl-10" />
        </div>
        <div class="flex gap-2 sm:ml-auto">
          <button id="cat-refresh" class="btn-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
          <button id="cat-export" class="btn-secondary btn-sm"><i class="bi bi-filetype-csv"></i> Export</button>
          <a href="/categories/create" class="btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Category</a>
        </div>
      </div>

      <div id="cat-grid" class="grid grid-cols-2 gap-4 p-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
        <div class="card p-4"><div class="skeleton h-20 w-full rounded-xl"></div><div class="skeleton mt-3 h-4 w-3/4"></div></div>
        <div class="card p-4"><div class="skeleton h-20 w-full rounded-xl"></div><div class="skeleton mt-3 h-4 w-3/4"></div></div>
        <div class="card p-4"><div class="skeleton h-20 w-full rounded-xl"></div><div class="skeleton mt-3 h-4 w-3/4"></div></div>
        <div class="card p-4"><div class="skeleton h-20 w-full rounded-xl"></div><div class="skeleton mt-3 h-4 w-3/4"></div></div>
      </div>

      <div class="p-4 pt-0"><%- include('../partials/pagination') %></div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/categories.js" defer></script>
</body>
</html>
