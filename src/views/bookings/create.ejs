<%- include('../partials/head', { pageTitle: 'Book Appointment', bodyAttrs: 'data-protected data-page="bookings-create"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'bookings' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/bookings" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Book a new appointment</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Reserve a service slot for a customer's vehicle</p>
      </div>
    </div>

    <form id="bk-create-form" class="mx-auto max-w-3xl" novalidate>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Customer -->
        <div class="card p-5 sm:col-span-2">
          <h3 class="mb-4 flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-person-badge text-brand-500"></i> Customer</h3>
          <div>
            <label class="label" for="bk-user">Select User</label>
            <select id="bk-user" class="input" required>
              <option value="">Loading users…</option>
            </select>
            <p class="field-error hidden" data-error-for="bk-user"></p>
          </div>
        </div>

        <!-- Vehicle -->
        <div class="card p-5 sm:col-span-2">
          <h3 class="mb-4 flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-car-front text-amber-500"></i> Vehicle</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label" for="bk-vname">Vehicle Name</label>
              <input id="bk-vname" type="text" class="input" placeholder="e.g. Maruti Swift" required />
              <p class="field-error hidden" data-error-for="bk-vname"></p>
            </div>
            <div>
              <label class="label" for="bk-regno">Registration No.</label>
              <input id="bk-regno" type="text" class="input font-mono uppercase" placeholder="MH12 AB 3456" required />
              <p class="field-error hidden" data-error-for="bk-regno"></p>
            </div>
            <div>
              <label class="label" for="bk-vtype">Vehicle Type</label>
              <select id="bk-vtype" class="input" required>
                <option value="">Loading categories…</option>
              </select>
              <p class="field-error hidden" data-error-for="bk-vtype"></p>
            </div>
            <div>
              <label class="label" for="bk-photo">Vehicle Photo <span class="font-normal normal-case text-slate-400">(optional)</span></label>
              <input id="bk-photo" type="file" accept="image/*" class="input !py-2.5 !text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-brand-600 hover:file:bg-brand-100" />
              <div id="bk-photo-preview" class="mt-2 hidden"><img class="h-20 rounded-xl object-cover ring-2 ring-brand-100 dark:ring-brand-500/20" alt="preview" /></div>
            </div>
          </div>
        </div>

        <!-- Service & slot -->
        <div class="card p-5 sm:col-span-2">
          <h3 class="mb-4 flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-wrench-adjustable text-emerald-500"></i> Service &amp; Slot</h3>
          <div class="grid gap-4 sm:grid-cols-3">
            <div class="sm:col-span-3">
              <label class="label" for="bk-service">Service</label>
              <select id="bk-service" class="input" required>
                <option value="">Loading services…</option>
              </select>
              <p class="field-error hidden" data-error-for="bk-service"></p>
            </div>
            <div>
              <label class="label" for="bk-date">Slot Date</label>
              <input id="bk-date" type="date" class="input" required />
              <p class="field-error hidden" data-error-for="bk-date"></p>
            </div>
            <div>
              <label class="label" for="bk-time">Slot Time</label>
              <input id="bk-time" type="time" class="input" required />
              <p class="field-error hidden" data-error-for="bk-time"></p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-end gap-2.5">
        <a href="/bookings" class="btn-secondary btn-md">Cancel</a>
        <button type="submit" class="btn-primary btn-md"><i class="bi bi-calendar-check"></i> Confirm Booking</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/bookings.js" defer></script>
</body>
</html>
