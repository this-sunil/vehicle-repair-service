<%- include('../partials/head', { pageTitle: 'Admin Profile', bodyAttrs: 'data-protected data-page="profile"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'profile' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <!-- Identity card -->
      <div class="card overflow-hidden h-fit">
        <div class="h-28 bg-gradient-to-r from-brand-600 to-violet-600"></div>
        <div class="-mt-14 flex flex-col items-center px-6 pb-8 text-center">
          <div id="pf-avatar" class="grid h-28 w-28 place-items-center rounded-3xl bg-gradient-to-br from-brand-500 to-violet-600 text-4xl font-extrabold text-white shadow-xl ring-4 ring-white dark:ring-slate-900">A</div>
          <h2 class="mt-4 text-xl font-extrabold text-slate-900 dark:text-white" id="pf-name">Administrator</h2>
          <span class="badge-blue mt-1.5 capitalize" id="pf-role">admin</span>
          <dl class="mt-6 w-full space-y-3 text-left">
            <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-2.5 dark:bg-slate-800/60">
              <dt class="flex items-center gap-2 text-xs font-semibold text-slate-400"><i class="bi bi-telephone"></i> Phone</dt>
              <dd class="text-sm font-bold text-slate-800 dark:text-slate-100" id="pf-phone">—</dd>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-2.5 dark:bg-slate-800/60">
              <dt class="flex items-center gap-2 text-xs font-semibold text-slate-400"><i class="bi bi-calendar-event"></i> Member since</dt>
              <dd class="text-sm font-bold text-slate-800 dark:text-slate-100" id="pf-joined">—</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Forms -->
      <div class="space-y-4 lg:col-span-2">
        <form id="pf-form" class="card space-y-5 p-6 sm:p-8" novalidate>
          <h3 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-person-gear text-brand-500"></i> Profile Details</h3>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label" for="pf-name-input">Full Name</label>
              <input id="pf-name-input" type="text" class="input" required />
              <p class="field-error hidden" data-error-for="pf-name-input"></p>
            </div>
            <div>
              <label class="label" for="pf-phone-input">Phone Number</label>
              <input id="pf-phone-input" type="tel" inputmode="numeric" class="input" required />
              <p class="field-error hidden" data-error-for="pf-phone-input"></p>
            </div>
          </div>

          <div>
            <label class="label" for="pf-photo">Profile Photo <span class="font-normal normal-case text-slate-400">(optional)</span></label>
            <div class="flex items-center gap-4">
              <div id="pf-photo-preview" class="grid h-16 w-16 place-items-center rounded-2xl bg-slate-100 text-slate-400 dark:bg-slate-800"><i class="bi bi-image text-2xl"></i></div>
              <input id="pf-photo" type="file" accept="image/*" class="input !py-2.5 !text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-brand-600 hover:file:bg-brand-100" />
            </div>
          </div>

          <div class="flex justify-end border-t border-slate-200 pt-5 dark:border-slate-800">
            <button type="submit" class="btn-primary btn-md"><i class="bi bi-check-lg"></i> Save Profile</button>
          </div>
        </form>

        <form id="pf-pass-form" class="card space-y-5 p-6 sm:p-8" novalidate>
          <h3 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-shield-lock text-rose-500"></i> Change Password</h3>

          <div class="grid gap-4 sm:grid-cols-3">
            <div>
              <label class="label" for="pf-current">Current Password</label>
              <input id="pf-current" type="password" class="input" autocomplete="current-password" required />
              <p class="field-error hidden" data-error-for="pf-current"></p>
            </div>
            <div>
              <label class="label" for="pf-new">New Password</label>
              <input id="pf-new" type="password" class="input" autocomplete="new-password" required minlength="6" />
              <p class="field-error hidden" data-error-for="pf-new"></p>
            </div>
          </div>

          <div class="flex justify-end border-t border-slate-200 pt-5 dark:border-slate-800">
            <button type="submit" class="btn-danger btn-md"><i class="bi bi-key"></i> Update Password</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/profile.js" defer></script>
</body>
</html>
