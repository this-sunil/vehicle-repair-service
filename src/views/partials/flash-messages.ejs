<div id="flashAlertContainer" class="mb-3">
  <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show elevation-1" role="alert">
      <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <h5><i class="icon fas fa-check-circle"></i> Success</h5>
      <%= success_msg %>
    </div>
  <% } %>

  <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show elevation-1" role="alert">
      <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <h5><i class="icon fas fa-ban"></i> Alert</h5>
      <%= error_msg %>
    </div>
  <% } %>
</div>
