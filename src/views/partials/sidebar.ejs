<!-- Main AdminLTE Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
  <!-- Brand Logo -->
  <a href="/dashboard" class="brand-link bg-dark">
    <div class="brand-image d-inline-flex align-items-center justify-content-center bg-primary rounded-circle elevation-2" style="width: 34px; height: 34px; margin-left: 0.8rem; margin-right: 0.5rem;">
      <i class="fas fa-tools text-white" style="font-size: 15px;"></i>
    </div>
    <span class="brand-text font-weight-bold tracking-tight">Vehicle<span class="text-primary font-weight-light">Service</span></span>
  </a>

  <!-- Sidebar -->
  <div class="sidebar">
    <!-- Sidebar user panel -->
    <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center">
      <div class="image">
        <img src="/public/images/placeholder.svg" class="img-circle elevation-2 admin-user-avatar" alt="Admin" style="width: 36px; height: 36px; object-fit: cover;">
      </div>
      <div class="info">
        <a href="/admin/profile" class="d-block font-weight-bold admin-user-name">Administrator</a>
        <div class="text-xs text-muted d-flex align-items-center">
          <span class="badge badge-success badge-pill py-0 px-2 mr-1" style="font-size: 9px;"><i class="fas fa-circle mr-1" style="font-size: 7px;"></i>Online</span>
          <span class="admin-user-role">Super Admin</span>
        </div>
      </div>
    </div>

    <!-- Sidebar Menu -->
    <nav class="mt-2">
      <ul class="nav nav-pills nav-sidebar flex-column nav-flat nav-child-indent" data-widget="treeview" role="menu" data-accordion="false">
        <li class="nav-header text-uppercase font-weight-bold text-muted small">Operations & Workflow</li>

        <li class="nav-item">
          <a href="/dashboard" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'dashboard') ? 'active' : '' %>">
            <i class="nav-icon fas fa-tachometer-alt"></i>
            <p>Executive Dashboard</p>
          </a>
        </li>

        <li class="nav-item">
          <a href="/bookings" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'bookings') ? 'active' : '' %>">
            <i class="nav-icon fas fa-calendar-check text-primary"></i>
            <p>
              Bookings
              <span class="badge badge-primary right" id="badgeBookingCount">20</span>
            </p>
          </a>
        </li>

        <li class="nav-item">
          <a href="/services" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'services') ? 'active' : '' %>">
            <i class="nav-icon fas fa-wrench text-warning"></i>
            <p>Vehicle Services</p>
          </a>
        </li>

        <li class="nav-item">
          <a href="/categories" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'categories') ? 'active' : '' %>">
            <i class="nav-icon fas fa-th-large text-info"></i>
            <p>
              Categories
              <span class="badge badge-info right" id="badgeCategoryCount">4</span>
            </p>
          </a>
        </li>

        <li class="nav-item">
          <a href="/shops" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'shops') ? 'active' : '' %>">
            <i class="nav-icon fas fa-map-marker-alt text-danger"></i>
            <p>
              Shops & Centers
              <span class="badge badge-secondary right" id="badgeShopCount">50</span>
            </p>
          </a>
        </li>

        <li class="nav-header text-uppercase font-weight-bold text-muted small mt-2">Management</li>

        <li class="nav-item">
          <a href="/users" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'users') ? 'active' : '' %>">
            <i class="nav-icon fas fa-users text-success"></i>
            <p>
              Users & Customers
              <span class="badge badge-success right" id="badgeUserCount">37</span>
            </p>
          </a>
        </li>

        <li class="nav-item">
          <a href="/plans" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'plans') ? 'active' : '' %>">
            <i class="nav-icon fas fa-id-card text-purple"></i>
            <p>Subscription Plans</p>
          </a>
        </li>

        <li class="nav-item">
          <a href="/notifications" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'notifications') ? 'active' : '' %>">
            <i class="nav-icon fas fa-bullhorn text-teal"></i>
            <p>Broadcast Alerts</p>
          </a>
        </li>

        <li class="nav-header text-uppercase font-weight-bold text-muted small mt-2">Configuration</li>

        <li class="nav-item">
          <a href="/admin/profile" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'profile') ? 'active' : '' %>">
            <i class="nav-icon fas fa-user-shield text-info"></i>
            <p>Admin Profile</p>
          </a>
        </li>

        <li class="nav-item">
          <a href="/admin/settings" class="nav-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'settings') ? 'active' : '' %>">
            <i class="nav-icon fas fa-cogs text-secondary"></i>
            <p>Platform Settings</p>
          </a>
        </li>

        <li class="nav-item mt-2">
          <a href="#" class="nav-link text-danger btn-logout">
            <i class="nav-icon fas fa-sign-out-alt"></i>
            <p class="font-weight-bold">Sign Out</p>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</aside>
