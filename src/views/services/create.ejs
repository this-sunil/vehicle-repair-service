<%- include('../partials/head', { pageTitle: 'Add Service', bodyAttrs: 'data-protected data-page="services-create"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'services' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/services" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Add a vehicle service</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Offer a new repair or maintenance service</p>
      </div>
    </div>

    <form id="svc-create-form" class="mx-auto max-w-2xl space-y-5 card p-6 sm:p-8" novalidate>
      <div>
        <label class="label" for="title">Service Title</label>
        <div class="relative">
          <i class="bi bi-tag absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input id="title" type="text" class="input !pl-10" placeholder="e.g. Full Engine Diagnostics" required />
        </div>
        <p class="field-error hidden" data-error-for="title"></p>
      </div>

      <div>
        <label class="label" for="description">Description</label>
        <textarea id="description" rows="4" class="input resize-none" placeholder="Describe what this service includes…" required></textarea>
        <p class="field-error hidden" data-error-for="description"></p>
      </div>

      <div>
        <label class="label" for="photo">Service Photo <span class="font-normal normal-case text-slate-400">(optional)</span></label>
        <input id="photo" type="file" accept="image/*" class="input !py-2.5 !text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-brand-600 hover:file:bg-brand-100" />
        <div id="photo-preview" class="mt-2 hidden"><img class="h-24 rounded-xl object-cover ring-2 ring-brand-100 dark:ring-brand-500/20" alt="preview" /></div>
      </div>

      <div class="flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
        <a href="/services" class="btn-secondary btn-md">Cancel</a>
        <button type="submit" class="btn-primary btn-md"><i class="bi bi-check-lg"></i> Add Service</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/services.js" defer></script>
</body>
</html>
