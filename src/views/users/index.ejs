<%- include('../partials/head', { pageTitle: 'Users Management', bodyAttrs: 'data-protected data-page="users"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'users' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-5 px-4 py-6 sm:px-6 lg:px-8">
    <%- include('../partials/flash-messages') %>

    <!-- Stats strip -->
    <div class="grid grid-cols-3 gap-3 sm:gap-4">
      <div class="card card-hover p-4 sm:p-5">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Accounts</p>
        <p class="mt-1 text-2xl font-extrabold text-slate-900 dark:text-white" id="stat-total">—</p>
      </div>
      <div class="card card-hover p-4 sm:p-5">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Customers</p>
        <p class="mt-1 text-2xl font-extrabold text-emerald-600 dark:text-emerald-400" id="stat-customers">—</p>
      </div>
      <div class="card card-hover p-4 sm:p-5">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Admins</p>
        <p class="mt-1 text-2xl font-extrabold text-brand-600 dark:text-brand-400" id="stat-admins">—</p>
      </div>
    </div>

    <!-- Toolbar + table -->
    <div class="card">
      <div class="flex flex-col gap-3 border-b border-slate-200 p-4 dark:border-slate-800 sm:flex-row sm:items-center">
        <div class="relative flex-1 sm:max-w-xs">
          <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input type="text" id="user-search" placeholder="Search name, phone…" class="input !pl-10" />
        </div>
        <select id="user-role" class="input sm:max-w-40">
          <option value="">All roles</option>
          <option value="user">Customers</option>
          <option value="admin">Admins</option>
        </select>
        <div class="flex gap-2 sm:ml-auto">
          <button id="user-refresh" class="btn-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
          <button id="user-export" class="btn-secondary btn-sm"><i class="bi bi-filetype-csv"></i> Export</button>
          <a href="/users/create" class="btn-primary btn-sm"><i class="bi bi-person-plus"></i> Add User</a>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr><th>User</th><th>Phone</th><th>Role</th><th>Joined</th><th class="text-right">Actions</th></tr>
          </thead>
          <tbody id="users-tbody">
            <tr><td colspan="5" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
            <tr><td colspan="5" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
            <tr><td colspan="5" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
          </tbody>
        </table>
      </div>

      <div class="p-4"><%- include('../partials/pagination') %></div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/users.js" defer></script>
</body>
</html>
