<%- include('../partials/head', { pageTitle: 'Edit Service Center', bodyAttrs: 'data-protected data-page="shops-edit" data-id="' + (typeof shopId !== 'undefined' ? shopId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'shops' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/shops" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Edit service center</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Update partner workshop details</p>
      </div>
    </div>

    <form id="shop-edit-form" class="mx-auto max-w-3xl grid grid-cols-1 gap-4 sm:grid-cols-2" novalidate>
      <div class="card space-y-4 p-5 sm:col-span-2">
        <h3 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-buildings text-brand-500"></i> Center Details</h3>
        <div>
          <label class="label" for="shopName">Center Name</label>
          <input id="shopName" type="text" class="input" required />
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <div><label class="label" for="city">City</label><input id="city" type="text" class="input" required /></div>
          <div><label class="label" for="phone">Phone</label><input id="phone" type="tel" inputmode="numeric" class="input" required /></div>
          <div><label class="label" for="shopTime">Working Hours</label><input id="shopTime" type="text" class="input" required /></div>
        </div>
      </div>

      <div class="card space-y-4 p-5 sm:col-span-2">
        <h3 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-geo-alt text-emerald-500"></i> Location</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><label class="label" for="lat">Latitude</label><input id="lat" type="number" step="any" class="input" required /></div>
          <div><label class="label" for="long">Longitude</label><input id="long" type="number" step="any" class="input" required /></div>
        </div>
      </div>

      <div class="card space-y-4 p-5 sm:col-span-2">
        <h3 class="flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-image text-amber-500"></i> Appearance</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="status">Status</label>
            <select id="status" class="input">
              <option value="true">Active — accepting bookings</option>
              <option value="false">Inactive — temporarily closed</option>
            </select>
          </div>
          <div>
            <label class="label" for="photo">Replace Photo <span class="font-normal normal-case text-slate-400">(optional)</span></label>
            <input id="photo" type="file" accept="image/*" class="input !py-2.5 !text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-brand-600 hover:file:bg-brand-100" />
            <div id="photo-preview" class="mt-2 hidden"><img class="h-20 rounded-xl object-cover ring-2 ring-brand-100 dark:ring-brand-500/20" alt="preview" /></div>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2.5 sm:col-span-2">
        <a href="/shops" class="btn-secondary btn-md">Cancel</a>
        <button type="submit" class="btn-primary btn-md"><i class="bi bi-check-lg"></i> Save Changes</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/shops.js" defer></script>
</body>
</html>
