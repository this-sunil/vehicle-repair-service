<%- include('../partials/head', { pageTitle: 'Service Details', bodyAttrs: 'data-protected data-page="services-show" data-id="' + (typeof serviceId !== 'undefined' ? serviceId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'services' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/services" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Service details</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Catalog entry overview</p>
      </div>
    </div>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-4 lg:grid-cols-3">
      <div class="card overflow-hidden lg:col-span-1">
        <div class="grid h-48 place-items-center bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900" id="s-photo">
          <i class="bi bi-tools text-5xl text-slate-300 dark:text-slate-600"></i>
        </div>
        <div class="p-5">
          <h3 class="text-base font-extrabold text-slate-900 dark:text-white" id="s-title">Loading…</h3>
          <p class="mt-1 text-xs text-slate-400" id="s-added">—</p>
        </div>
      </div>

      <div class="card p-6 lg:col-span-2">
        <h3 class="mb-4 flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-card-text text-brand-500"></i> Description</h3>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300" id="s-desc">—</p>
        <div class="mt-6 flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
          <button class="btn-secondary btn-md" id="s-del"><i class="bi bi-trash3"></i> Delete</button>
          <a href="#" class="btn-primary btn-md" id="s-edit-link"><i class="bi bi-pencil"></i> Edit Service</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/services.js" defer></script>
</body>
</html>
