<%- include('../partials/head', { pageTitle: 'Plan Details', bodyAttrs: 'data-protected data-page="plans-show" data-id="' + (typeof planId !== 'undefined' ? planId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'plans' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/plans" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Plan details</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Subscription package overview</p>
      </div>
    </div>

    <div class="mx-auto max-w-md">
      <div class="card card-hover relative overflow-hidden p-8 text-center animate-fadeUp" id="p-card">
        <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brand-500 to-violet-600"></div>
        <span class="badge-blue capitalize" id="p-type">—</span>
        <h3 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white" id="p-title">Loading…</h3>
        <p class="mt-4"><span class="text-4xl font-extrabold text-slate-900 dark:text-white" id="p-price">₹—</span><span class="text-sm font-medium text-slate-400" id="p-per">/month</span></p>
        <p class="mt-2 text-xs text-slate-400" id="p-added">—</p>
        <div class="mt-8 flex justify-center gap-2.5">
          <button class="btn-secondary btn-md" id="p-del"><i class="bi bi-trash3"></i> Delete</button>
          <a href="#" class="btn-primary btn-md" id="p-edit-link"><i class="bi bi-pencil"></i> Edit Plan</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/plans.js" defer></script>
</body>
</html>
