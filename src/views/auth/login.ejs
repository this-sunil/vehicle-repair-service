<%- include('../partials/head', { pageTitle: 'Sign In', bodyClass: 'bg-slate-950 dark:bg-slate-950', bodyAttrs: 'data-auth-page' }) %>

<!-- Decorative background -->
<div class="pointer-events-none fixed inset-0 overflow-hidden">
  <div class="absolute -left-40 -top-40 h-96 w-96 rounded-full bg-brand-600/20 blur-3xl"></div>
  <div class="absolute -bottom-40 -right-40 h-96 w-96 rounded-full bg-violet-600/20 blur-3xl"></div>
  <div class="absolute left-1/2 top-1/3 h-64 w-64 -translate-x-1/2 rounded-full bg-sky-500/10 blur-3xl"></div>
</div>

<main class="relative grid min-h-screen place-items-center px-4 py-10">
  <div class="grid w-full max-w-5xl overflow-hidden rounded-3xl border border-white/10 bg-slate-900/60 shadow-2xl shadow-black/50 backdrop-blur-xl lg:grid-cols-2">

    <!-- Left: brand showcase -->
    <div class="relative hidden flex-col justify-between overflow-hidden bg-gradient-to-br from-brand-600 via-brand-700 to-violet-800 p-10 lg:flex">
      <div class="pointer-events-none absolute inset-0 opacity-20" style="background-image:radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size:32px 32px"></div>
      <div class="relative">
        <div class="flex items-center gap-3">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-white/15 backdrop-blur">
            <i class="bi bi-tools text-2xl text-white"></i>
          </div>
          <div>
            <div class="text-lg font-extrabold tracking-tight text-white">Vehicle<span class="text-brand-200">Service</span></div>
            <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/50">Control Center</div>
          </div>
        </div>
        <h1 class="mt-14 text-3xl font-extrabold leading-tight text-white">
          Run your entire workshop from <span class="text-brand-200">one command center.</span>
        </h1>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/60">
          Bookings, service centers, customers and revenue — unified, responsive, and supercharged with an AI copilot.
        </p>
        <ul class="mt-8 space-y-3.5 text-sm text-white/80">
          <li class="flex items-center gap-3"><span class="grid h-7 w-7 place-items-center rounded-lg bg-white/10"><i class="bi bi-calendar-check"></i></span>Live appointment pipeline</li>
          <li class="flex items-center gap-3"><span class="grid h-7 w-7 place-items-center rounded-lg bg-white/10"><i class="bi bi-stars"></i></span>AI insights &amp; copilot chat</li>
          <li class="flex items-center gap-3"><span class="grid h-7 w-7 place-items-center rounded-lg bg-white/10"><i class="bi bi-graph-up-arrow"></i></span>Weekly trend analytics</li>
        </ul>
      </div>
      <p class="relative text-xs text-white/40">© <%= new Date().getFullYear() %> VehicleService Admin</p>
    </div>

    <!-- Right: login form -->
    <div class="p-8 sm:p-10 lg:p-12">
      <div class="mx-auto max-w-sm">
        <div class="mb-8 text-center lg:text-left">
          <div class="mb-6 flex justify-center lg:hidden">
            <div class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-brand-500 to-violet-600 shadow-lg shadow-brand-600/40">
              <i class="bi bi-tools text-2xl text-white"></i>
            </div>
          </div>
          <h2 class="text-2xl font-extrabold text-white">Welcome back 👋</h2>
          <p class="mt-1.5 text-sm text-slate-400">Sign in to your admin control center</p>
        </div>

        <form id="login-form" class="space-y-4" novalidate>
          <div>
            <label class="label !text-slate-400" for="phone">Phone Number</label>
            <div class="relative">
              <i class="bi bi-telephone absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
              <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="username" placeholder="98765 43210" class="input !border-slate-700 !bg-slate-800/60 !pl-10 text-white placeholder:!text-slate-500" required />
            </div>
            <p class="field-error hidden" data-error-for="phone"></p>
          </div>

          <div>
            <label class="label !text-slate-400" for="pass">Password</label>
            <div class="relative">
              <i class="bi bi-shield-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
              <input id="pass" name="pass" type="password" autocomplete="current-password" placeholder="••••••••" class="input !border-slate-700 !bg-slate-800/60 !pl-10 pr-11 text-white placeholder:!text-slate-500" required />
              <button type="button" id="toggle-pass" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 transition hover:text-slate-300" aria-label="Show password"><i class="bi bi-eye"></i></button>
            </div>
            <p class="field-error hidden" data-error-for="pass"></p>
          </div>

          <button type="submit" id="login-btn" class="btn-primary btn-md w-full !py-3">
            <span class="btn-label">Sign In</span>
            <i class="bi bi-arrow-right btn-label"></i>
            <i class="bi bi-arrow-repeat hidden animate-spin"></i>
          </button>
        </form>

        <div class="mt-8 border-t border-white/5 pt-6 text-center text-sm text-slate-400">
          Admin access only — contact your administrator if you need an account.
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Toasts -->
<div id="vs-toasts" class="fixed right-4 top-4 z-[80] flex w-[calc(100%-2rem)] max-w-sm flex-col gap-2"></div>

<script src="/public/js/admin.js" defer></script>
<script src="/public/js/login.js" defer></script>
</body>
</html>
