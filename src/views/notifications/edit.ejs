<%- include('../partials/head', { pageTitle: 'Edit Notification', activeMenu: 'notifications' }) %>

<div class="corona-wrapper">
  <%- include('../partials/sidebar', { activeMenu: 'notifications' }) %>

  <div class="corona-main">
    <%- include('../partials/navbar') %>

    <main class="corona-content">
      <%- include('../partials/flash-messages') %>

      <!-- Page Header -->
      <div class="page-header">
        <div>
          <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Notifications', url: '/notifications' }, { label: 'Notification #' + (typeof notificationId !== 'undefined' ? notificationId : ''), url: '/notifications/' + (typeof notificationId !== 'undefined' ? notificationId : '') }, { label: 'Edit' } ] }) %>
          <h1 class="page-title">Edit Broadcast Notification</h1>
          <p class="page-subtitle">Update notification title, text, or visual banner</p>
        </div>
        <a href="/notifications" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Back to Notifications
        </a>
      </div>

      <div class="row">
        <div class="col-lg-8 col-xl-7">
          <div class="card">
            <div class="card-header">
              <h5 class="card-title">Modify Notification #<%= typeof notificationId !== 'undefined' ? notificationId : '' %></h5>
            </div>
            <div class="card-body">
              <div id="noteEditLoading" class="text-center py-4">
                <div class="spinner-border text-primary me-2"></div> Loading notification...
              </div>

              <form id="standaloneEditNotificationForm" class="d-none" enctype="multipart/form-data">
                <input type="hidden" name="id" id="editNoteIdInput" value="<%= typeof notificationId !== 'undefined' ? notificationId : '' %>">

                <div class="d-flex align-items-center gap-3 mb-4 p-3 bg-light rounded">
                  <img src="/public/images/placeholder.svg" id="editNoteAvatarPreview" class="table-thumb" style="width: 72px; height: 72px; object-fit: cover; border-radius: 10px;">
                  <div>
                    <label class="form-label mb-1">Update Banner</label>
                    <input type="file" name="photo" class="form-control form-control-sm" accept="image/*">
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label">Notification Title <span class="text-danger">*</span></label>
                  <input type="text" name="title" id="editNoteTitleInput" class="form-control" required>
                </div>

                <div class="mb-3">
                  <label class="form-label">Message Details <span class="text-danger">*</span></label>
                  <textarea name="description" id="editNoteDescInput" class="form-control" rows="5" required></textarea>
                </div>

                <div class="d-flex align-items-center gap-2 mt-4">
                  <button type="submit" class="btn btn-primary px-4">
                    <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                    Save Changes
                  </button>
                  <a href="/notifications" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<script src="/public/js/notifications.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const noteId = Number('<%= typeof notificationId !== 'undefined' ? notificationId : '' %>');
    if (!noteId) return;

    try {
      const res = await apiRequest('/api/fetchNotification', {
        method: 'POST',
        body: { page: 1 }
      });

      if (res.ok && res.data.result) {
        const item = res.data.result.find(n => n.id === noteId);
        if (item) {
          document.getElementById('editNoteTitleInput').value = item.title || '';
          document.getElementById('editNoteDescInput').value = item.subtitle || item.description || '';
          if (item.photo) {
            document.getElementById('editNoteAvatarPreview').src = getMediaUrl(item.photo);
          }
          document.getElementById('noteEditLoading').classList.add('d-none');
          document.getElementById('standaloneEditNotificationForm').classList.remove('d-none');
        } else {
          document.getElementById('noteEditLoading').innerHTML = '<div class="text-danger">Notification not found.</div>';
        }
      }
    } catch (e) {
      document.getElementById('noteEditLoading').innerHTML = '<div class="text-danger">Failed to load notification.</div>';
    }
  });
</script>
