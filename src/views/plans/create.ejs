<%- include('../partials/head', { pageTitle: 'Add Plan', bodyAttrs: 'data-protected data-page="plans-create"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'plans' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/plans" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Create a subscription plan</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Design a recurring package for customers</p>
      </div>
    </div>

    <form id="plan-create-form" class="mx-auto max-w-xl space-y-5 card p-6 sm:p-8" novalidate>
      <div>
        <label class="label" for="plan_title">Plan Title</label>
        <div class="relative">
          <i class="bi bi-credit-card-2-front absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input id="plan_title" type="text" class="input !pl-10" placeholder="e.g. Premium Care" required />
        </div>
        <p class="field-error hidden" data-error-for="plan_title"></p>
      </div>

      <div>
        <label class="label" for="plan_type">Billing Cycle</label>
        <select id="plan_type" class="input" required>
          <option value="monthly">Monthly</option>
          <option value="quarterly">Quarterly</option>
          <option value="yearly">Yearly</option>
        </select>
        <p class="field-error hidden" data-error-for="plan_type"></p>
      </div>

      <div>
        <label class="label" for="plan_price">Price (₹)</label>
        <div class="relative">
          <i class="bi bi-currency-rupee absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input id="plan_price" type="number" min="0" step="0.01" class="input !pl-10" placeholder="499" required />
        </div>
        <p class="field-error hidden" data-error-for="plan_price"></p>
      </div>

      <div class="flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
        <a href="/plans" class="btn-secondary btn-md">Cancel</a>
        <button type="submit" class="btn-primary btn-md"><i class="bi bi-check-lg"></i> Create Plan</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/plans.js" defer></script>
</body>
</html>
