<%- include('../partials/head', { pageTitle: 'Executive Dashboard', activeMenu: 'dashboard' }) %>

<div class="wrapper">
  <!-- Navbar -->
  <%- include('../partials/navbar') %>

  <!-- Main Sidebar Container -->
  <%- include('../partials/sidebar', { activeMenu: 'dashboard' }) %>

  <!-- Content Wrapper -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2 align-items-center">
          <div class="col-sm-6">
            <h1 class="m-0 font-weight-bold text-dark" style="font-size: 1.75rem;">
              <i class="fas fa-tachometer-alt text-primary mr-2"></i>Executive Dashboard
            </h1>
            <p class="text-muted small mb-0">Live operations, appointment queues, and performance metrics</p>
          </div>
          <div class="col-sm-6 text-sm-right mt-2 mt-sm-0">
            <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Dashboard' } ] }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <%- include('../partials/flash-messages') %>

        <!-- AdminLTE Small Boxes (KPIs) Row -->
        <div class="row">
          <!-- Total Bookings -->
          <div class="col-lg-3 col-6">
            <div class="small-box bg-gradient-info elevation-2">
              <div class="inner">
                <h3 id="kpiBookings" class="font-weight-bold">—</h3>
                <p class="text-uppercase font-weight-semibold" style="font-size: 0.85rem; letter-spacing: 0.5px;">Service Bookings</p>
              </div>
              <div class="icon">
                <i class="fas fa-calendar-check"></i>
              </div>
              <a href="/bookings" class="small-box-footer">
                Manage Bookings <i class="fas fa-arrow-circle-right ml-1"></i>
              </a>
            </div>
          </div>

          <!-- Total Registered Users -->
          <div class="col-lg-3 col-6">
            <div class="small-box bg-gradient-success elevation-2">
              <div class="inner">
                <h3 id="kpiUsers" class="font-weight-bold">—</h3>
                <p class="text-uppercase font-weight-semibold" style="font-size: 0.85rem; letter-spacing: 0.5px;">Registered Users</p>
              </div>
              <div class="icon">
                <i class="fas fa-user-friends"></i>
              </div>
              <a href="/users" class="small-box-footer">
                Manage Accounts <i class="fas fa-arrow-circle-right ml-1"></i>
              </a>
            </div>
          </div>

          <!-- Active Services -->
          <div class="col-lg-3 col-6">
            <div class="small-box bg-gradient-warning elevation-2 text-white">
              <div class="inner" style="color: #fff !important;">
                <h3 id="kpiServices" class="font-weight-bold text-white">—</h3>
                <p class="text-uppercase font-weight-semibold text-white" style="font-size: 0.85rem; letter-spacing: 0.5px;">Active Services</p>
              </div>
              <div class="icon">
                <i class="fas fa-wrench" style="color: rgba(255,255,255,0.4) !important;"></i>
              </div>
              <a href="/services" class="small-box-footer" style="color: #fff !important;">
                View Catalog <i class="fas fa-arrow-circle-right ml-1"></i>
              </a>
            </div>
          </div>

          <!-- Partner Garages / Shops -->
          <div class="col-lg-3 col-6">
            <div class="small-box bg-gradient-danger elevation-2">
              <div class="inner">
                <h3 id="kpiShops" class="font-weight-bold">—</h3>
                <p class="text-uppercase font-weight-semibold" style="font-size: 0.85rem; letter-spacing: 0.5px;">Partner Garages</p>
              </div>
              <div class="icon">
                <i class="fas fa-store-alt"></i>
              </div>
              <a href="/shops" class="small-box-footer">
                Service Centers <i class="fas fa-arrow-circle-right ml-1"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- AdminLTE Secondary Info Boxes Row -->
        <div class="row">
          <!-- Categories -->
          <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box elevation-1 mb-3">
              <span class="info-box-icon bg-indigo elevation-1"><i class="fas fa-car-side"></i></span>
              <div class="info-box-content">
                <span class="info-box-text text-muted font-weight-semibold">Vehicle Categories</span>
                <span class="info-box-number font-weight-bold text-dark" id="kpiCategories">—</span>
              </div>
              <a href="/categories" class="btn btn-sm btn-link text-muted pr-2"><i class="fas fa-chevron-right"></i></a>
            </div>
          </div>

          <!-- Subscription Plans -->
          <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box elevation-1 mb-3">
              <span class="info-box-icon bg-teal elevation-1"><i class="fas fa-id-card"></i></span>
              <div class="info-box-content">
                <span class="info-box-text text-muted font-weight-semibold">Subscription Plans</span>
                <span class="info-box-number font-weight-bold text-dark" id="kpiPlans">—</span>
              </div>
              <a href="/plans" class="btn btn-sm btn-link text-muted pr-2"><i class="fas fa-chevron-right"></i></a>
            </div>
          </div>

          <!-- Broadcast Notifications -->
          <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box elevation-1 mb-3">
              <span class="info-box-icon bg-purple elevation-1"><i class="fas fa-bullhorn"></i></span>
              <div class="info-box-content">
                <span class="info-box-text text-muted font-weight-semibold">Broadcast Alerts</span>
                <span class="info-box-number font-weight-bold text-dark" id="kpiNotifications">—</span>
              </div>
              <a href="/notifications" class="btn btn-sm btn-link text-muted pr-2"><i class="fas fa-chevron-right"></i></a>
            </div>
          </div>

          <!-- Refresh Control -->
          <div class="col-12 col-sm-6 col-md-3">
            <div class="info-box elevation-1 mb-3 d-flex align-items-center justify-content-between p-2">
              <div class="d-flex align-items-center">
                <span class="info-box-icon bg-navy elevation-1 mr-3"><i class="fas fa-cloud"></i></span>
                <div>
                  <span class="info-box-text text-muted font-weight-semibold" style="font-size: 11px;">API Engine</span>
                  <span class="badge badge-success" style="font-size: 10px;"><i class="fas fa-circle mr-1" style="font-size: 6px;"></i>Online</span>
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-outline-primary elevation-1 font-weight-semibold" id="btnRefreshDashboard">
                <i class="fas fa-sync-alt mr-1"></i> Refresh
              </button>
            </div>
          </div>
        </div>

        <!-- Interactive Charts Row -->
        <div class="row">
          <!-- Chart 1: Vehicle Types -->
          <div class="col-lg-6">
            <div class="card card-primary card-outline elevation-1">
              <div class="card-header border-0 pb-0">
                <h3 class="card-title font-weight-bold text-dark">
                  <i class="fas fa-chart-pie mr-1 text-primary"></i>
                  Bookings by Vehicle Type
                </h3>
                <div class="card-tools">
                  <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                    <i class="fas fa-minus"></i>
                  </button>
                  <button type="button" class="btn btn-tool" data-card-widget="maximize" title="Maximize">
                    <i class="fas fa-expand"></i>
                  </button>
                </div>
              </div>
              <div class="card-body">
                <div class="chart position-relative" style="min-height: 260px; height: 260px;">
                  <canvas id="vehicleTypeChart" style="min-height: 260px; height: 260px; max-height: 260px; max-width: 100%;"></canvas>
                </div>
              </div>
            </div>
          </div>

          <!-- Chart 2: Garages by City -->
          <div class="col-lg-6">
            <div class="card card-success card-outline elevation-1">
              <div class="card-header border-0 pb-0">
                <h3 class="card-title font-weight-bold text-dark">
                  <i class="fas fa-chart-bar mr-1 text-success"></i>
                  Partner Garages by City
                </h3>
                <div class="card-tools">
                  <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                    <i class="fas fa-minus"></i>
                  </button>
                  <button type="button" class="btn btn-tool" data-card-widget="maximize" title="Maximize">
                    <i class="fas fa-expand"></i>
                  </button>
                </div>
              </div>
              <div class="card-body">
                <div class="chart position-relative" style="min-height: 260px; height: 260px;">
                  <canvas id="cityChart" style="min-height: 260px; height: 260px; max-height: 260px; max-width: 100%;"></canvas>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Records Tables Row -->
        <div class="row">
          <!-- Recent Appointments -->
          <div class="col-lg-7">
            <div class="card card-outline card-info elevation-1">
              <div class="card-header border-0 d-flex align-items-center justify-content-between">
                <h3 class="card-title font-weight-bold text-dark">
                  <i class="fas fa-calendar-alt text-info mr-1"></i>
                  Recent Service Appointments
                </h3>
                <div class="card-tools">
                  <a href="/bookings" class="btn btn-sm btn-tool text-primary font-weight-bold">
                    View All <i class="fas fa-arrow-right ml-1"></i>
                  </a>
                </div>
              </div>
              <div class="card-body table-responsive p-0">
                <table class="table table-striped table-valign-middle mb-0" id="recentBookingsTable">
                  <thead>
                    <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                      <th>Vehicle & Customer</th>
                      <th>Service</th>
                      <th>Slot</th>
                      <th>Type</th>
                      <th class="text-right">Action</th>
                    </tr>
                  </thead>
                  <tbody id="recentBookingsTbody">
                    <tr>
                      <td colspan="5" class="text-center py-4 text-muted">
                        <i class="fas fa-spinner fa-spin mr-2 text-primary"></i> Loading appointments...
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Recent Registered Users -->
          <div class="col-lg-5">
            <div class="card card-outline card-secondary elevation-1">
              <div class="card-header border-0 d-flex align-items-center justify-content-between">
                <h3 class="card-title font-weight-bold text-dark">
                  <i class="fas fa-user-plus text-secondary mr-1"></i>
                  Newly Registered Users
                </h3>
                <div class="card-tools">
                  <a href="/users" class="btn btn-sm btn-tool text-primary font-weight-bold">
                    View All <i class="fas fa-arrow-right ml-1"></i>
                  </a>
                </div>
              </div>
              <div class="card-body table-responsive p-0">
                <table class="table table-striped table-valign-middle mb-0" id="recentUsersTable">
                  <thead>
                    <tr class="text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                      <th>User</th>
                      <th>Phone</th>
                      <th class="text-right">Role</th>
                    </tr>
                  </thead>
                  <tbody id="recentUsersTbody">
                    <tr>
                      <td colspan="3" class="text-center py-4 text-muted">
                        <i class="fas fa-spinner fa-spin mr-2 text-success"></i> Loading users...
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Main Footer -->
  <%- include('../partials/footer') %>

<!-- Dashboard Controller Script -->
<script src="/public/js/dashboard.js"></script>
