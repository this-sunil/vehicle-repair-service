<%- include('../partials/head', { pageTitle: 'User Details', bodyAttrs: 'data-protected data-page="users-show" data-id="' + (typeof userId !== 'undefined' ? userId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'users' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/users" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">User details</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Profile, role and activity</p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <!-- Profile card -->
      <div class="card overflow-hidden lg:col-span-1">
        <div class="h-24 bg-gradient-to-r from-brand-600 to-violet-600"></div>
        <div class="-mt-12 flex flex-col items-center px-6 pb-6 text-center">
          <div id="u-avatar" class="grid h-24 w-24 place-items-center rounded-3xl bg-gradient-to-br from-brand-500 to-violet-600 text-3xl font-extrabold text-white shadow-xl ring-4 ring-white dark:ring-slate-900">—</div>
          <h3 class="mt-4 text-lg font-extrabold text-slate-900 dark:text-white" id="u-name">Loading…</h3>
          <span class="mt-1.5 badge-blue capitalize" id="u-role">user</span>
          <dl class="mt-6 w-full space-y-3 text-left">
            <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-2.5 dark:bg-slate-800/60">
              <dt class="flex items-center gap-2 text-xs font-semibold text-slate-400"><i class="bi bi-telephone"></i> Phone</dt>
              <dd class="text-sm font-bold text-slate-800 dark:text-slate-100" id="u-phone">—</dd>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-2.5 dark:bg-slate-800/60">
              <dt class="flex items-center gap-2 text-xs font-semibold text-slate-400"><i class="bi bi-calendar-event"></i> Joined</dt>
              <dd class="text-sm font-bold text-slate-800 dark:text-slate-100" id="u-joined">—</dd>
            </div>
            <div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-2.5 dark:bg-slate-800/60">
              <dt class="flex items-center gap-2 text-xs font-semibold text-slate-400"><i class="bi bi-fingerprint"></i> User ID</dt>
              <dd class="text-sm font-bold text-slate-800 dark:text-slate-100" id="u-id">—</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Bookings of this user -->
      <div class="card lg:col-span-2">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-slate-800">
          <div class="flex items-center gap-2.5">
            <i class="bi bi-calendar-check text-lg text-brand-500"></i>
            <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">Booking History</h3>
          </div>
          <span class="badge-slate" id="u-booking-count">—</span>
        </div>
        <div class="overflow-x-auto">
          <table class="table-base">
            <thead><tr><th>Vehicle</th><th>Service</th><th>Slot</th><th></th></tr></thead>
            <tbody id="u-bookings">
              <tr><td colspan="4" class="!py-8 text-center text-sm text-slate-400"><i class="bi bi-arrow-repeat inline animate-spin mr-1"></i> Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/users.js" defer></script>
</body>
</html>
