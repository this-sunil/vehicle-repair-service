<%- include('../partials/head', { pageTitle: 'Service Centers & Shops', activeMenu: 'shops' }) %>

<div class="admin-wrapper">
  <%- include('../partials/sidebar', { activeMenu: 'shops' }) %>

  <div class="admin-main">
    <%- include('../partials/navbar') %>

    <main class="admin-content">
      <%- include('../partials/flash-messages') %>

      <!-- Page Header -->
      <div class="page-header">
        <div>
          <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Shops' } ] }) %>
          <h1 class="page-title">Service Centers & Garages</h1>
          <p class="page-subtitle">Manage registered auto repair stations, operating hours, coordinates, and contact details</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="loadShops()">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
          </button>
          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createShopModal">
            <i class="bi bi-plus-lg me-1"></i> Add Service Center
          </button>
          <a href="/shops/create" class="btn btn-outline-primary btn-sm d-none d-md-inline-block">
            <i class="bi bi-box-arrow-up-right me-1"></i> Full Form
          </a>
        </div>
      </div>

      <!-- Filters & Search Toolbar -->
      <div class="card mb-3">
        <div class="card-body p-3">
          <div class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" id="shopSearchInput" placeholder="Search shops by name, city, or phone...">
              </div>
            </div>
            <div class="col-sm-6 col-md-3 col-lg-3">
              <select class="form-select" id="shopCityFilter">
                <option value="">All Cities</option>
                <!-- Populated dynamically -->
              </select>
            </div>
            <div class="col text-end">
              <span class="text-muted small">Total: <strong id="shopsCountSpan" class="text-dark">—</strong> centers</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Shops Table Card -->
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 searchable-table">
            <thead>
              <tr>
                <th style="width: 70px;">ID</th>
                <th>Shop / Garage</th>
                <th>City</th>
                <th>Contact</th>
                <th>Status</th>
                <th>Geo Coordinates</th>
                <th class="text-end" style="width: 140px;">Actions</th>
              </tr>
            </thead>
            <tbody id="shopsTableBody">
              <!-- Populated by shops.js -->
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<!-- Create Shop Modal -->
<div class="modal fade" id="createShopModal" tabindex="-1" aria-labelledby="createShopModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="createShopModalLabel"><i class="bi bi-shop text-primary me-2"></i>Register New Service Center</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="createShopForm" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Shop / Center Name <span class="text-danger">*</span></label>
              <input type="text" name="shopName" class="form-control" placeholder="e.g. Pune Wheels Auto Care" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">City <span class="text-danger">*</span></label>
              <input type="text" name="city" class="form-control" placeholder="e.g. Pune, Mumbai" required>
            </div>

            <div class="col-md-6">
              <label class="form-label">Phone Number <span class="text-danger">*</span></label>
              <input type="tel" name="phone" class="form-control" placeholder="e.g. 9823011111" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Operating Hours</label>
              <input type="text" name="shopTime" class="form-control" placeholder="e.g. 09:00 AM - 08:00 PM" value="09:00 AM - 08:00 PM">
            </div>

            <div class="col-md-4">
              <label class="form-label">Latitude</label>
              <input type="number" step="any" name="lat" class="form-control" placeholder="18.5204" value="18.5204">
            </div>
            <div class="col-md-4">
              <label class="form-label">Longitude</label>
              <input type="number" step="any" name="long" class="form-control" placeholder="73.8567" value="73.8567">
            </div>
            <div class="col-md-4">
              <label class="form-label">Operating Status <span class="text-danger">*</span></label>
              <select name="status" class="form-select">
                <option value="true" selected>Operational</option>
                <option value="false">Closed / Inactive</option>
              </select>
            </div>

            <div class="col-12">
              <label class="form-label">Shop Banner / Photo</label>
              <input type="file" name="photo" class="form-control" accept="image/*">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
            Register Shop
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Shop Modal -->
<div class="modal fade" id="editShopModal" tabindex="-1" aria-labelledby="editShopModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editShopModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Service Center</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editShopForm" enctype="multipart/form-data">
        <input type="hidden" name="sid" value="">
        <div class="modal-body">
          <div class="d-flex align-items-center gap-3 mb-3 p-2 bg-light rounded">
            <img src="/public/images/placeholder.svg" id="editShopPhotoPreview" class="table-thumb" style="width: 56px; height: 56px;">
            <div>
              <div class="fw-semibold">Update Shop Photo</div>
              <input type="file" name="photo" class="form-control form-control-sm mt-1" accept="image/*">
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Shop Name <span class="text-danger">*</span></label>
              <input type="text" name="shopName" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">City <span class="text-danger">*</span></label>
              <input type="text" name="city" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Phone <span class="text-danger">*</span></label>
              <input type="tel" name="phone" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Operating Hours</label>
              <input type="text" name="shopTime" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Latitude</label>
              <input type="number" step="any" name="lat" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Longitude</label>
              <input type="number" step="any" name="long" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label">Status</label>
              <select name="status" class="form-select">
                <option value="true">Operational</option>
                <option value="false">Closed / Inactive</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/public/js/shops.js"></script>
