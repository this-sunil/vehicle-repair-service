<%- include('../partials/head', { pageTitle: 'Add Category', bodyAttrs: 'data-protected data-page="categories-create"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'categories' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/categories" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Add vehicle category</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Group services by vehicle classification</p>
      </div>
    </div>

    <form id="cat-create-form" class="mx-auto max-w-xl space-y-5 card p-6 sm:p-8" novalidate>
      <div>
        <label class="label" for="title">Category Title</label>
        <div class="relative">
          <i class="bi bi-grid-3x3-gap absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input id="title" type="text" class="input !pl-10" placeholder="e.g. Two Wheeler" required />
        </div>
        <p class="field-error hidden" data-error-for="title"></p>
      </div>

      <div>
        <label class="label" for="type">Vehicle Type</label>
        <input id="type" type="text" class="input" list="type-suggestions" placeholder="e.g. Bike" required />
        <datalist id="type-suggestions">
          <option value="Car"></option>
          <option value="Bike"></option>
          <option value="Truck"></option>
          <option value="Van"></option>
          <option value="Auto Rickshaw"></option>
        </datalist>
        <p class="field-error hidden" data-error-for="type"></p>
      </div>

      <div>
        <label class="label" for="photo">Category Photo <span class="font-normal normal-case text-slate-400">(optional)</span></label>
        <input id="photo" type="file" accept="image/*" class="input !py-2.5 !text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-brand-600 hover:file:bg-brand-100" />
        <div id="photo-preview" class="mt-2 hidden"><img class="h-24 rounded-xl object-cover ring-2 ring-brand-100 dark:ring-brand-500/20" alt="preview" /></div>
      </div>

      <div class="flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
        <a href="/categories" class="btn-secondary btn-md">Cancel</a>
        <button type="submit" class="btn-primary btn-md"><i class="bi bi-check-lg"></i> Add Category</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/categories.js" defer></script>
</body>
</html>
