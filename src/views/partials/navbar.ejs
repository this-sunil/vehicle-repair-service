<!-- Top Navbar -->
<header class="admin-navbar">
  <!-- Left Side: Toggle & Search -->
  <div class="navbar-left">
    <!-- Desktop Sidebar Toggle -->
    <button type="button" class="btn-toggle-sidebar d-none d-lg-flex" id="sidebarToggleBtn" title="Toggle Sidebar">
      <i class="bi bi-layout-sidebar"></i>
    </button>
    <!-- Mobile Sidebar Toggle -->
    <button type="button" class="btn-toggle-sidebar d-flex d-lg-none" id="mobileSidebarToggleBtn" title="Open Menu">
      <i class="bi bi-list fs-4"></i>
    </button>

    <!-- Global Search -->
    <div class="navbar-search d-none d-md-block">
      <i class="bi bi-search"></i>
      <input type="text" class="form-control" id="tableSearchInput" placeholder="Quick search in tables...">
    </div>
  </div>

  <!-- Right Side: Quick Actions, Alerts & User Menu -->
  <div class="navbar-right">
    <!-- Quick Create Dropdown -->
    <div class="dropdown">
      <button class="btn btn-sm btn-outline-primary dropdown-toggle rounded-pill px-3" type="button" id="quickActionDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-plus-lg me-1"></i> Create
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="quickActionDropdown">
        <li><h6 class="dropdown-header">Quick Actions</h6></li>
        <li><a class="dropdown-item" href="/bookings/create"><i class="bi bi-calendar-plus text-primary me-2"></i>New Booking</a></li>
        <li><a class="dropdown-item" href="/services/create"><i class="bi bi-wrench text-info me-2"></i>Add Service</a></li>
        <li><a class="dropdown-item" href="/categories/create"><i class="bi bi-grid-plus text-warning me-2"></i>New Category</a></li>
        <li><a class="dropdown-item" href="/shops/create"><i class="bi bi-shop text-success me-2"></i>Add Shop</a></li>
        <li><a class="dropdown-item" href="/users/create"><i class="bi bi-person-plus text-secondary me-2"></i>Register User</a></li>
      </ul>
    </div>

    <!-- Notifications Dropdown -->
    <div class="dropdown">
      <button class="btn btn-toggle-sidebar position-relative" type="button" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell"></i>
        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
          <span class="visually-hidden">New alerts</span>
        </span>
      </button>
      <div class="dropdown-menu dropdown-menu-end shadow-sm p-0" style="width: 290px;" aria-labelledby="notificationsDropdown">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
          <h6 class="mb-0 fw-bold">Notifications</h6>
          <a href="/notifications" class="text-primary small text-decoration-none">View all</a>
        </div>
        <div class="p-2">
          <a href="/bookings" class="dropdown-item d-flex gap-2 p-2 rounded">
            <div class="bg-primary-subtle text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
              <i class="bi bi-calendar-check"></i>
            </div>
            <div>
              <div class="small fw-semibold">New Bookings Received</div>
              <div class="text-muted small">Check latest customer slots</div>
            </div>
          </a>
        </div>
        <div class="p-2 border-top text-center">
          <a href="/notifications/create" class="btn btn-sm btn-link text-decoration-none p-0">Broadcast Notification</a>
        </div>
      </div>
    </div>

    <!-- Live System Status indicator -->
    <div class="d-none d-sm-flex align-items-center gap-2 px-2 py-1 rounded bg-light border">
      <span class="p-1 bg-success rounded-circle"></span>
      <span class="small text-muted fw-semibold">API Online</span>
    </div>

    <!-- User Profile Dropdown -->
    <div class="dropdown">
      <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <img src="/public/images/placeholder.svg" alt="Admin" class="user-avatar admin-user-avatar" style="width: 36px; height: 36px;">
        <span class="d-none d-md-inline fw-semibold text-dark admin-user-name">Admin</span>
      </a>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuDropdown">
        <li class="px-3 py-2 border-bottom">
          <div class="fw-bold admin-user-name">Admin</div>
          <div class="text-muted small admin-user-role">Administrator</div>
        </li>
        <li><a class="dropdown-item" href="/admin/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
        <li><a class="dropdown-item" href="/admin/settings"><i class="bi bi-gear me-2"></i>Site Settings</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item text-danger btn-logout" href="#"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
      </ul>
    </div>
  </div>
</header>
