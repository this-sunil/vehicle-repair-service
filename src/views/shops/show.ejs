<%- include('../partials/head', { pageTitle: 'Service Center Details', activeMenu: 'shops' }) %>

<div class="admin-wrapper">
  <%- include('../partials/sidebar', { activeMenu: 'shops' }) %>

  <div class="admin-main">
    <%- include('../partials/navbar') %>

    <main class="admin-content">
      <%- include('../partials/flash-messages') %>

      <!-- Page Header -->
      <div class="page-header">
        <div>
          <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Shops', url: '/shops' }, { label: 'Shop Details' } ] }) %>
          <h1 class="page-title">Service Center Details</h1>
          <p class="page-subtitle">Inspect workshop location, contact, operating hours, and status</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <a href="/shops" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Shops
          </a>
          <a href="/shops/<%= typeof shopId !== 'undefined' ? shopId : '' %>/edit" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Center
          </a>
        </div>
      </div>

      <div id="showShopLoading" class="text-center py-5">
        <div class="spinner-border text-primary me-2"></div> Loading center details...
      </div>

      <div id="showShopContent" class="d-none">
        <div class="row g-4">
          <div class="col-lg-8">
            <div class="card mb-4">
              <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="card-title"><i class="bi bi-shop text-primary me-2"></i>Service Center #<span id="showShopId"><%= typeof shopId !== 'undefined' ? shopId : '' %></span></h5>
                <span id="showShopStatusBadge"></span>
              </div>
              <div class="card-body p-4">
                <div class="d-flex flex-column flex-sm-row gap-4 mb-4">
                  <img src="/public/images/placeholder.svg" id="showShopPhoto" alt="Shop Photo" class="rounded-3 shadow-sm border" style="width: 140px; height: 140px; object-fit: cover;">
                  <div class="flex-grow-1">
                    <h3 class="fw-bold mb-2 text-dark" id="showShopName">—</h3>
                    <div class="mb-2"><span class="badge bg-light text-dark border"><i class="bi bi-geo-alt-fill me-1 text-danger"></i><span id="showShopCity">—</span></span></div>
                    <div class="text-muted small mb-1"><i class="bi bi-clock me-1"></i>Hours: <strong id="showShopHours" class="text-dark">—</strong></div>
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>Phone: <strong id="showShopPhone" class="text-dark font-monospace">—</strong></div>
                  </div>
                </div>

                <hr class="my-4">

                <div class="row g-3">
                  <div class="col-sm-6">
                    <div class="text-muted small">Geo Latitude</div>
                    <div class="fs-6 fw-bold font-monospace mt-1" id="showShopLat">—</div>
                  </div>
                  <div class="col-sm-6">
                    <div class="text-muted small">Geo Longitude</div>
                    <div class="fs-6 fw-bold font-monospace mt-1" id="showShopLong">—</div>
                  </div>
                  <div class="col-sm-6">
                    <div class="text-muted small">Registered Since</div>
                    <div class="fs-6 fw-semibold text-dark mt-1" id="showShopCreated">—</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<script src="/public/js/shops.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const shopId = Number('<%= typeof shopId !== 'undefined' ? shopId : '' %>');
    if (!shopId) return;

    try {
      const res = await apiRequest('/api/fetchShop', {
        method: 'POST',
        body: { page: 1, limit: 100 }
      });

      if (res.ok && res.data.result) {
        const item = res.data.result.find(s => s.sid === shopId);
        if (item) {
          document.getElementById('showShopName').textContent = item.shopname || item.shopName || '—';
          document.getElementById('showShopCity').textContent = item.city || '—';
          document.getElementById('showShopHours').textContent = item.shoptime || item.shopTime || '09:00 AM - 08:00 PM';
          document.getElementById('showShopPhone').textContent = item.phone ? String(item.phone) : '—';
          document.getElementById('showShopLat').textContent = item.lat || '—';
          document.getElementById('showShopLong').textContent = item.long || '—';
          document.getElementById('showShopCreated').textContent = formatDate(item.created_at);

          const isActive = item.status === true || item.status === 'true' || item.status === 1;
          document.getElementById('showShopStatusBadge').innerHTML = isActive
            ? '<span class="badge-status badge-active">Operational</span>'
            : '<span class="badge-status badge-inactive">Closed</span>';

          const photo = item.shopphoto || item.shopPhoto;
          if (photo) {
            document.getElementById('showShopPhoto').src = getMediaUrl(photo);
          }

          document.getElementById('showShopLoading').classList.add('d-none');
          document.getElementById('showShopContent').classList.remove('d-none');
        } else {
          document.getElementById('showShopLoading').innerHTML = '<div class="text-danger">Service center not found.</div>';
        }
      }
    } catch (e) {
      document.getElementById('showShopLoading').innerHTML = '<div class="text-danger">Failed to load service center details.</div>';
    }
  });
</script>
