<!-- Optional breadcrumb helper -->
<nav class="flex items-center gap-1.5 text-[11px] font-medium text-slate-400" aria-label="Breadcrumb">
  <a href="/dashboard" class="transition hover:text-brand-500"><i class="bi bi-house-door"></i></a>
  <% if (typeof crumbs !== 'undefined' && crumbs) { %>
    <% crumbs.forEach(function(c) { %>
      <i class="bi bi-chevron-right text-[8px]"></i>
      <% if (c.href) { %>
        <a href="<%= c.href %>" class="transition hover:text-brand-500"><%= c.label %></a>
      <% } else { %>
        <span class="font-bold text-slate-500 dark:text-slate-300"><%= c.label %></span>
      <% } %>
    <% }); %>
  <% } %>
</nav>
