<%- include('../partials/head', { pageTitle: 'Register User', bodyAttrs: 'data-protected data-page="users-create"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'users' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <%- include('../partials/flash-messages') %>

    <div class="mx-auto max-w-2xl">
      <div class="mb-6 flex items-center gap-3">
        <a href="/users" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
        <div>
          <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Register a new user</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400">Create a customer or administrator account</p>
        </div>
      </div>

      <form id="user-create-form" class="card space-y-5 p-6 sm:p-8" novalidate>
        <div>
          <label class="label" for="name">Full Name</label>
          <div class="relative">
            <i class="bi bi-person absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
            <input id="name" type="text" class="input !pl-10" placeholder="e.g. Ravi Kumar" required />
          </div>
          <p class="field-error hidden" data-error-for="name"></p>
        </div>

        <div>
          <label class="label" for="phone">Phone Number</label>
          <div class="relative">
            <i class="bi bi-telephone absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
            <input id="phone" type="tel" inputmode="numeric" class="input !pl-10" placeholder="98765 43210" required />
          </div>
          <p class="field-error hidden" data-error-for="phone"></p>
        </div>

        <div>
          <label class="label" for="pass">Password</label>
          <div class="relative">
            <i class="bi bi-shield-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
            <input id="pass" type="password" class="input !pl-10" placeholder="Minimum 6 characters" required minlength="6" />
          </div>
          <p class="field-error hidden" data-error-for="pass"></p>
        </div>

        <div class="flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
          <a href="/users" class="btn-secondary btn-md">Cancel</a>
          <button type="submit" class="btn-primary btn-md" id="user-create-btn">
            <i class="bi bi-check-lg"></i> Create Account
          </button>
        </div>
      </form>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/users.js" defer></script>
</body>
</html>
