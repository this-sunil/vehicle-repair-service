<%- include('../partials/head', { pageTitle: 'Vehicle Services', activeMenu: 'services' }) %>

<div class="admin-wrapper">
  <%- include('../partials/sidebar', { activeMenu: 'services' }) %>

  <div class="admin-main">
    <%- include('../partials/navbar') %>

    <main class="admin-content">
      <%- include('../partials/flash-messages') %>

      <!-- Page Header -->
      <div class="page-header">
        <div>
          <%- include('../partials/breadcrumbs', { crumbs: [ { label: 'Services' } ] }) %>
          <h1 class="page-title">Vehicle Services Catalog</h1>
          <p class="page-subtitle">Manage maintenance, repairs, washes, oil changes, and detailing packages</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" onclick="loadServices()">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
          </button>
          <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createServiceModal">
            <i class="bi bi-plus-lg me-1"></i> Add Service
          </button>
          <a href="/services/create" class="btn btn-outline-primary btn-sm d-none d-md-inline-block">
            <i class="bi bi-box-arrow-up-right me-1"></i> Full Form
          </a>
        </div>
      </div>

      <!-- Filters & Live Search Toolbar -->
      <div class="card mb-3">
        <div class="card-body p-3">
          <div class="row g-2 align-items-center">
            <div class="col-md-7 col-lg-6">
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" id="serviceSearchInput" placeholder="Live search services by title or description...">
              </div>
            </div>
            <div class="col text-end">
              <span class="text-muted small">Total: <strong id="servicesCountSpan" class="text-dark">—</strong> services</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Services Table Card -->
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 searchable-table">
            <thead>
              <tr>
                <th style="width: 70px;">ID</th>
                <th>Service Name</th>
                <th>Description</th>
                <th>Created</th>
                <th class="text-end" style="width: 140px;">Actions</th>
              </tr>
            </thead>
            <tbody id="servicesTableBody">
              <!-- Populated by services.js -->
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<!-- Create Service Modal -->
<div class="modal fade" id="createServiceModal" tabindex="-1" aria-labelledby="createServiceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="createServiceModalLabel"><i class="bi bi-tools text-primary me-2"></i>Add Service Package</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="createServiceForm" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Service Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Brake Pad Replacement" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="3" placeholder="Provide details about what this service entails..." required></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Service Thumbnail / Banner</label>
            <input type="file" name="photo" class="form-control" accept="image/*">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
            Add Service
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="editServiceModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Service</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="editServiceForm" enctype="multipart/form-data">
        <input type="hidden" name="id" value="">
        <div class="modal-body">
          <div class="d-flex align-items-center gap-3 mb-3">
            <img src="/public/images/placeholder.svg" id="editServicePhotoPreview" class="table-thumb" style="width: 56px; height: 56px;">
            <div>
              <div class="fw-semibold">Change Image</div>
              <input type="file" name="photo" class="form-control form-control-sm mt-1" accept="image/*">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Service Title <span class="text-danger">*</span></label>
            <input type="text" name="title" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Description <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="3" required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">
            <span class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/public/js/services.js"></script>
