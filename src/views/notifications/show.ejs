<%- include('../partials/head', { pageTitle: 'Broadcast Details', bodyAttrs: 'data-protected data-page="notifications-show" data-id="' + (typeof notificationId !== 'undefined' ? notificationId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'notifications' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/notifications" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Broadcast details</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Announcement record</p>
      </div>
    </div>

    <div class="mx-auto max-w-2xl card overflow-hidden animate-fadeUp">
      <div class="flex items-center gap-4 bg-gradient-to-r from-brand-600 to-violet-600 p-6">
        <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/15"><i class="bi bi-megaphone text-2xl text-white"></i></div>
        <div class="min-w-0">
          <h3 class="truncate text-lg font-extrabold text-white" id="n-title">Loading…</h3>
          <p class="text-xs text-white/60" id="n-sent">—</p>
        </div>
      </div>
      <div id="n-photo" class="hidden"><img class="max-h-72 w-full object-cover" alt="banner" /></div>
      <div class="p-6">
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300" id="n-desc">—</p>
        <div class="mt-6 flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
          <button class="btn-secondary btn-md" id="n-del"><i class="bi bi-trash3"></i> Delete</button>
          <a href="#" class="btn-primary btn-md" id="n-edit-link"><i class="bi bi-pencil"></i> Edit Broadcast</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/notifications.js" defer></script>
</body>
</html>
