<%- include('../partials/head', { pageTitle: 'Edit User', bodyAttrs: 'data-protected data-page="users-edit" data-id="' + (typeof userId !== 'undefined' ? userId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'users' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/users" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Edit user</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Update profile details</p>
      </div>
    </div>

    <form id="user-edit-form" class="mx-auto max-w-2xl space-y-5 card p-6 sm:p-8" novalidate>
      <div>
        <label class="label" for="name">Full Name</label>
        <input id="name" type="text" class="input" placeholder="Full name" required />
        <p class="field-error hidden" data-error-for="name"></p>
      </div>

      <div>
        <label class="label" for="phone">Phone Number</label>
        <input id="phone" type="tel" inputmode="numeric" class="input" placeholder="98765 43210" required />
        <p class="field-error hidden" data-error-for="phone"></p>
      </div>

      <div>
        <label class="label" for="photo">Profile Photo <span class="font-normal normal-case text-slate-400">(optional)</span></label>
        <div class="flex items-center gap-4">
          <div id="photo-preview" class="grid h-16 w-16 place-items-center rounded-2xl bg-slate-100 text-slate-400 dark:bg-slate-800"><i class="bi bi-image text-2xl"></i></div>
          <input id="photo" type="file" accept="image/*" class="input !py-2.5 !text-xs file:mr-3 file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-brand-600 hover:file:bg-brand-100" />
        </div>
      </div>

      <div class="flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
        <a href="/users" class="btn-secondary btn-md">Cancel</a>
        <button type="submit" class="btn-primary btn-md"><i class="bi bi-check-lg"></i> Save Changes</button>
      </div>
    </form>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/users.js" defer></script>
</body>
</html>
