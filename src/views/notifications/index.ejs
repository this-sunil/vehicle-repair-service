<%- include('../partials/head', { pageTitle: 'Broadcast Notifications', bodyAttrs: 'data-protected data-page="notifications"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'notifications' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-5 px-4 py-6 sm:px-6 lg:px-8">
    <%- include('../partials/flash-messages') %>

    <div class="card">
      <div class="flex flex-col gap-3 border-b border-slate-200 p-4 dark:border-slate-800 sm:flex-row sm:items-center">
        <div class="relative flex-1 sm:max-w-xs">
          <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>
          <input type="text" id="ntf-search" placeholder="Search broadcasts…" class="input !pl-10" />
        </div>
        <div class="flex gap-2 sm:ml-auto">
          <button id="ntf-refresh" class="btn-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
          <button id="ntf-export" class="btn-secondary btn-sm"><i class="bi bi-filetype-csv"></i> Export</button>
          <a href="/notifications/create" class="btn-primary btn-sm"><i class="bi bi-megaphone"></i> New Broadcast</a>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr><th>Broadcast</th><th>Message</th><th>Sent</th><th class="text-right">Actions</th></tr>
          </thead>
          <tbody id="ntf-tbody">
            <tr><td colspan="4" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
            <tr><td colspan="4" class="!px-4 !py-8"><span class="skeleton inline-block h-5 w-full"></span></td></tr>
          </tbody>
        </table>
      </div>

      <div class="p-4"><%- include('../partials/pagination') %></div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/notifications.js" defer></script>
</body>
</html>
