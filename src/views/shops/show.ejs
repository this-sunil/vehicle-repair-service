<%- include('../partials/head', { pageTitle: 'Service Center Details', bodyAttrs: 'data-protected data-page="shops-show" data-id="' + (typeof shopId !== 'undefined' ? shopId : '') + '"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'shops' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-center gap-3">
      <a href="/shops" class="icon-btn"><i class="bi bi-arrow-left"></i></a>
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Service center details</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">Partner workshop profile</p>
      </div>
    </div>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-4 lg:grid-cols-3">
      <div class="card overflow-hidden">
        <div class="grid h-40 place-items-center bg-gradient-to-br from-emerald-500 to-teal-600" id="sh-photo">
          <i class="bi bi-buildings text-5xl text-white/70"></i>
        </div>
        <div class="p-5">
          <h3 class="text-base font-extrabold text-slate-900 dark:text-white" id="sh-name">Loading…</h3>
          <p class="mt-1 flex items-center gap-1.5 text-xs text-slate-400"><i class="bi bi-geo-alt"></i> <span id="sh-city">—</span></p>
        </div>
      </div>

      <div class="card p-6 lg:col-span-2">
        <h3 class="mb-5 flex items-center gap-2 text-sm font-bold text-slate-800 dark:text-slate-100"><i class="bi bi-info-circle text-brand-500"></i> Center Information</h3>
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Phone</dt>
            <dd class="mt-1.5 font-mono text-sm font-semibold text-slate-800 dark:text-slate-100" id="sh-phone">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Working Hours</dt>
            <dd class="mt-1.5 text-sm font-semibold text-slate-800 dark:text-slate-100" id="sh-hours">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Status</dt>
            <dd class="mt-1.5" id="sh-status">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800/50">
            <dt class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Coordinates</dt>
            <dd class="mt-1.5 font-mono text-sm font-semibold text-slate-800 dark:text-slate-100" id="sh-coords">—</dd>
          </div>
        </dl>
        <div class="mt-5 rounded-2xl border border-slate-200 p-4 text-center dark:border-slate-800">
          <a href="#" target="_blank" rel="noopener" id="sh-map-link" class="btn-secondary btn-md"><i class="bi bi-map"></i> View on Map</a>
        </div>
        <div class="mt-6 flex justify-end gap-2.5 border-t border-slate-200 pt-5 dark:border-slate-800">
          <button class="btn-secondary btn-md" id="sh-del"><i class="bi bi-trash3"></i> Delete</button>
          <a href="#" class="btn-primary btn-md" id="sh-edit-link"><i class="bi bi-pencil"></i> Edit Center</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/shops.js" defer></script>
</body>
</html>
