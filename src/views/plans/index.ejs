<%- include('../partials/head', { pageTitle: 'Subscription Plans', bodyAttrs: 'data-protected data-page="plans"' }) %>

<%- include('../partials/sidebar', { activeMenu: 'plans' }) %>

<div id="vs-main" class="flex min-h-screen flex-col transition-all duration-200">
  <%- include('../partials/navbar') %>

  <main class="flex-1 space-y-5 px-4 py-6 sm:px-6 lg:px-8">
    <%- include('../partials/flash-messages') %>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-slate-500 dark:text-slate-400">Recurring packages customers can subscribe to</p>
      <div class="flex gap-2">
        <button id="plan-refresh" class="btn-secondary btn-sm"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        <button id="plan-export" class="btn-secondary btn-sm"><i class="bi bi-filetype-csv"></i> Export</button>
        <a href="/plans/create" class="btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add Plan</a>
      </div>
    </div>

    <div id="plan-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
      <div class="card h-80 p-6"><div class="skeleton h-full w-full rounded-2xl"></div></div>
      <div class="card h-80 p-6"><div class="skeleton h-full w-full rounded-2xl"></div></div>
      <div class="card h-80 p-6"><div class="skeleton h-full w-full rounded-2xl"></div></div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<script src="/public/js/plans.js" defer></script>
</body>
</html>
