<!-- Corona Sidebar -->
<aside class="corona-sidebar" id="coronaSidebar">
  <!-- Brand -->
  <div class="sidebar-brand">
    <div class="brand-logo">
      <i class="fas fa-tools"></i>
    </div>
    <span class="brand-name">Vehicle<span>Service</span></span>
  </div>

  <!-- User Panel -->
  <div class="sidebar-user">
    <img src="/public/images/placeholder.svg" class="sidebar-user-avatar admin-user-avatar" alt="Admin">
    <div class="sidebar-user-info">
      <div class="sidebar-user-name admin-user-name">Administrator</div>
      <div class="sidebar-user-role">
        <span class="sidebar-status-dot"></span>
        <span class="admin-user-role">Super Admin</span>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav>
    <ul class="sidebar-menu">
      <li class="sidebar-menu-label">Operations &amp; Workflow</li>

      <li class="sidebar-menu-item">
        <a href="/dashboard" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'dashboard') ? 'active' : '' %>">
          <i class="bi bi-speedometer2"></i>
          <span>Executive Dashboard</span>
        </a>
      </li>

      <li class="sidebar-menu-item">
        <a href="/bookings" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'bookings') ? 'active' : '' %>">
          <i class="bi bi-calendar-check"></i>
          <span>Bookings</span>
          <span class="sidebar-menu-badge badge bg-primary" id="badgeBookingCount">20</span>
        </a>
      </li>

      <li class="sidebar-menu-item">
        <a href="/services" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'services') ? 'active' : '' %>">
          <i class="bi bi-wrench-adjustable"></i>
          <span>Vehicle Services</span>
        </a>
      </li>

      <li class="sidebar-menu-item">
        <a href="/categories" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'categories') ? 'active' : '' %>">
          <i class="bi bi-grid-3x3-gap"></i>
          <span>Categories</span>
          <span class="sidebar-menu-badge badge bg-info" id="badgeCategoryCount">4</span>
        </a>
      </li>

      <li class="sidebar-menu-item">
        <a href="/shops" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'shops') ? 'active' : '' %>">
          <i class="bi bi-geo-alt"></i>
          <span>Shops &amp; Centers</span>
          <span class="sidebar-menu-badge badge bg-secondary" id="badgeShopCount">50</span>
        </a>
      </li>

      <li class="sidebar-menu-label">Management</li>

      <li class="sidebar-menu-item">
        <a href="/users" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'users') ? 'active' : '' %>">
          <i class="bi bi-people"></i>
          <span>Users &amp; Customers</span>
          <span class="sidebar-menu-badge badge bg-success" id="badgeUserCount">37</span>
        </a>
      </li>

      <li class="sidebar-menu-item">
        <a href="/plans" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'plans') ? 'active' : '' %>">
          <i class="bi bi-credit-card-2-front"></i>
          <span>Subscription Plans</span>
        </a>
      </li>

      <li class="sidebar-menu-item">
        <a href="/notifications" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'notifications') ? 'active' : '' %>">
          <i class="bi bi-megaphone"></i>
          <span>Broadcast Alerts</span>
        </a>
      </li>

      <li class="sidebar-menu-label">Configuration</li>

      <li class="sidebar-menu-item">
        <a href="/admin/profile" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'profile') ? 'active' : '' %>">
          <i class="bi bi-shield-person"></i>
          <span>Admin Profile</span>
        </a>
      </li>

      <li class="sidebar-menu-item">
        <a href="/admin/settings" class="sidebar-menu-link <%= (typeof activeMenu !== 'undefined' && activeMenu === 'settings') ? 'active' : '' %>">
          <i class="bi bi-gear"></i>
          <span>Platform Settings</span>
        </a>
      </li>
    </ul>
  </nav>

  <!-- Logout Footer -->
  <div class="sidebar-footer">
    <a href="#" class="btn-logout">
      <i class="bi bi-box-arrow-right"></i>
      <span>Sign Out</span>
    </a>
  </div>
</aside>
